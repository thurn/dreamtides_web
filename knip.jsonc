{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Run with `npm run knip`; `npm run review:full` runs it beside lint after
  // preparing the workspace, whose generated files it resolves. Vite, Vitest,
  // ESLint, and the package.json scripts supply the default entry points; the
  // entries below are the ones knip cannot infer.
  "entry": [
    // review.mjs spawns these by path rather than importing them.
    "scripts/run-eslint.mjs",
    "scripts/review-related-tests.mjs",
    // The QA scenario runner, its prelude and scenarios, the card sweep, and
    // the production-bundle check, all run as `node scripts/qa/<file>` or
    // loaded by the runner from a scenario path.
    "scripts/qa/**/*.mjs",
    // perf-ab.ts runs these by path; developers run them with `npx tsx`.
    "scripts/bench-engine.ts",
    "scripts/lib/report-resource-usage.mjs",
    "scripts/content-inventory.ts",
    // The Playwright MCP client the Phase 4 card screenshot sweep imports.
    "scripts/screenshot-runtime.mjs",
    // Compile-time prop contract checks that `tsc` runs; nothing imports them.
    "src/**/__type_tests__/*.typecheck.tsx"
  ],
  "ignoreDependencies": [
    // Referenced only by the package.json `overrides` pin.
    "brace-expansion"
  ],
  "ignore": [
    // The vendored brace-expansion package that the override above installs.
    "vendor/brace-expansion/**"
  ],
  // A type or constant exported for callers and also used in its own module
  // (component prop types, view-model shapes) is part of a deliberate API.
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // The engine's public surface; its lane owns these exports.
    "src/engine/**": ["exports", "types", "duplicates"],
    // RuleTester-facing helpers in the custom ESLint rules.
    "eslint-rules/**": ["exports"]
  }
}
