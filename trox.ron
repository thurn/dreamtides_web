(
  source_locale: "en-US",

  terms: "localization/terms.ron",

  source_bundle: ".generated/localization/bundles/en-US.trox.json",

  source_report: ".generated/localization/reports/en-US.csv",

  sources: [
    (
      language: TypeScript,
      include: ["src/**/*.ts", "src/**/*.tsx"],
      exclude: [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.d.ts",
        "src/generated/**",
        "src/editor/**",
        "src/debug/**",
        "src/battle/debug/**",
        "src/cumulus/docs/**",
      ],
    ),
    (
      language: Ron,
      include: ["data/**/*.ron"],
      exclude: ["data/internal/**/*.ron", "data/cards.ron"],
    ),
  ],

  locales: {
    "ar": (
      profile: "localization/qa/ar.ron",
      csv: ".generated/localization/qa/ar.csv",
      bundle: ".generated/localization/bundles/ar.trox.json",
    ),
    "es": (
      profile: "localization/qa/es.ron",
      csv: ".generated/localization/qa/es.csv",
      bundle: ".generated/localization/bundles/es.trox.json",
    ),
    "ja": (
      profile: "localization/qa/ja.ron",
      csv: ".generated/localization/qa/ja.csv",
      bundle: ".generated/localization/bundles/ja.trox.json",
    ),
    "ru": (
      profile: "localization/qa/ru.ron",
      csv: ".generated/localization/qa/ru.csv",
      bundle: ".generated/localization/bundles/ru.trox.json",
    ),
  },

  max_expanded_rows_per_entry: 256,

  lint: (
    default_warning: Deny,
    rules: {
      "trox.missing-ron-description": (
        level: Allow,
        reason: "Canonical RON catalogs intentionally use concise Tx(\"source text\") values without inline translator descriptions.",
      ),
      "trox.formula-injection": (
        level: Allow,
        reason: "Reviewed source-English delta labels intentionally begin with +; localization CSV files are data inputs and must not be executed as spreadsheet formulas.",
      ),
      "trox.omitted-placeholder": (
        level: Allow,
        reason: "Reviewed complete selector branches intentionally omit values that are absent or lexically unnecessary: untitled artwork, cards without rules, free costs, singular fixed labels, and single-object actions.",
      ),
      "trox.human-row-expansion": (
        level: Allow,
        reason: "Reviewed 12-row battle participant summary jointly selects viewer relationship and locale-specific Points grammar so translators receive complete accessible sentences.",
      ),
    },
  ),
)
