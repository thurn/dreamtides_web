    {
      "name": "transfiguration",
      "tsType": "CardTransfigurationDisplay",
      "unionMembers": [],
      "required": false,
      "defaultValue": null,
      "description": "When set, paints the card as transfigured: a small colored gem follows the\nname, the changed corner stat(s) take the tint, and only the added/changed\nrules text is tinted (driven by the descriptor's marked text). The card\nitself should already carry the transfigured stats and rules text — pass the\n`card` and `display` from `buildTransfigurationDisplay` together."
    },
    {
      "name": "className",
      "tsType": "string",
      "unionMembers": [],
      "required": false,
      "defaultValue": null,
      "description": "Additional CSS class name for the root element."
    },
    {
      "name": "large",
      "tsType": "boolean",
      "unionMembers": [],
      "required": false,
      "defaultValue": "false",
      "description": "Use larger text sizes for rules text, name, type line, and stats."
    },
    {
      "name": "figment",
      "tsType": "boolean",
      "unionMembers": [],
      "required": false,
      "defaultValue": "false",
      "description": "Render the figment frame (rules §Figments): no energy orb, the spark floats\nas a large mark in the top-right corner instead of inside a name bar, and\nthe rules box takes a black-on-light frosted treatment. A figment has no\nname bar by default; pass `figmentTitleBar` to show one (for a named figment\nlike a Legionnaire, or while its name is being edited)."
    },
    {
      "name": "figmentTitleBar",
      "tsType": "boolean",
      "unionMembers": [],
      "required": false,
      "defaultValue": "false",
      "description": "In figment mode, render the top title bar holding the card name (left\naligned, dark character-card treatment). Ignored when `figment` is false."
    },
    {
      "name": "hideRulesText",
      "tsType": "boolean",
      "unionMembers": [],
      "required": false,
      "defaultValue": "false",
      "description": "Hide rules text for dense card surfaces that show identity and stats."
    },
    {
      "name": "suppressHoverHelp",
      "tsType": "boolean",
      "unionMembers": [],
      "required": false,
      "defaultValue": "false",
      "description": "When true, the corner stat tooltips and the card's term-definition hover\npanel are suppressed. The card editor uses this to keep hover behavior calm\nacross a dense grid, and the card-preview surfaces\n(`CardHoverPreview` / `BattleCardHoverPreview`) use it on the enlarged card\nbecause they render their own definitions panel alongside the preview."
    },
    {
      "name": "slots",
      "tsType": "CardViewSlots",
      "unionMembers": [],
      "required": false,
      "defaultValue": "{}",
      "description": "Optional editor wrappers for individual rendered card slots."
    },
    {
      "name": "onRulesFontSizeChange",
      "tsType": "((fontSizePx: number) => void)",
      "unionMembers": [],
      "required": false,
      "defaultValue": null,
      "description": "Called with the rules-text font size (in px) the auto-shrink fitter\ncomputed to fit the rules box, whenever it changes. The card editor uses\nthis to drive its font-size overlay and font-size sort."
    },
    {
      "name": "onBoxTopFracChange",
      "tsType": "((boxTopFrac: number | null) => void)",
      "unionMembers": [],
      "required": false,
      "defaultValue": null,
      "description": "Called with the rules text box's top as a fraction of card height (null when\nthe card has no rules box or it is not yet measured), whenever it changes.\nThe art-crop editor uses this to floor zoom-out and pan against the same\nbox-relative safe area the card renders with."
    },
    {
      "name": "eagerRulesFit",
      "tsType": "boolean",
      "unionMembers": [],
      "required": false,
      "defaultValue": "false",
      "description": "Measure the rules-text fit immediately instead of deferring until the card\nnears the viewport. The card editor sets this while sorting by font size so\nevery card reports a stable fitted size up front; without it the sort would\nreshuffle endlessly as off-screen cards measured only after being moved."
    },
    {
      "name": "rulesTextboxExpanded",
      "tsType": "boolean",
      "unionMembers": [],
      "required": false,
      "defaultValue": "false",
      "description": "Grow the rules text box to a taller editing height. The card editor sets\nthis while its rules-text field is open so the inline textarea has room to\nshow and edit several lines at once instead of being clipped to the\nthree-line display cap."
    }
  ],
