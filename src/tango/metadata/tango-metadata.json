  "HoverPopover": [
    {
      "name": "children",
      "tsType": "ReactNode",
      "unionMembers": [],
      "required": true,
      "defaultValue": null,
      "description": "The element that triggers the popover on hover."
    },
    {
      "name": "content",
      "tsType": "ReactNode | ((context: HoverPopoverContentContext) => ReactNode)",
      "unionMembers": [],
      "required": true,
      "defaultValue": null,
      "description": "The popover body. Rendered into a portal when visible."
    },
    {
      "name": "delayMs",
      "tsType": "number",
      "unionMembers": [],
      "required": false,
      "defaultValue": "500",
      "description": "Delay before showing the popover (ms). Defaults to 500ms."
    },
    {
      "name": "placement",
      "tsType": "Placement",
      "unionMembers": [
        "left",
        "top"
      ],
      "required": false,
      "defaultValue": "top",
      "description": "Preferred side to anchor the popover relative to the trigger.\n- `\"top\"` (default) centers the popover above the trigger and flips to\n  the bottom when the trigger sits near the top edge of the viewport.\n- `\"left\"` anchors the popover to the left of the trigger and flips to\n  the right when the trigger sits near the left edge of the viewport.\n  Useful for triggers on the right edge of the viewport (e.g. the\n  right-side deck sidebar) where the popover would otherwise appear\n  detached above or below the row.\n\nIn both cases the popover is shifted along the perpendicular axis as\nneeded so it stays fully inside the viewport."
    },
    {
      "name": "maxWidthPx",
      "tsType": "number | null",
      "unionMembers": [],
      "required": false,
      "defaultValue": null,
      "description": "Override the popover's max-width cap (px). Defaults to 260px, which\nsuits short glossary blurbs. Pass `null` to disable the cap entirely\nwhen `content` is a self-sizing element such as a card preview."
    },
    {
      "name": "triggerAs",
      "tsType": "\"div\" | \"span\"",
      "unionMembers": [
        "div",
        "span"
      ],
      "required": false,
      "defaultValue": "span",
      "description": "The DOM element type for the trigger wrapper. Defaults to `\"span\"` for\ninline use within text. Pass `\"div\"` for block-level triggers."
    },
    {
      "name": "className",
      "tsType": "string",
      "unionMembers": [],
      "required": false,
      "defaultValue": null,
      "description": "Additional class name for the trigger wrapper."
    },
    {
      "name": "style",
      "tsType": "CSSProperties",
      "unionMembers": [],
      "required": false,
      "defaultValue": null,
      "description": "Additional inline style for the trigger wrapper."
    }
  ],
