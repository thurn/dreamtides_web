{
  "name": "journey-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "launch": "npm install && npm start -- --open",
    "qai": "npm install && npm start -- --open \"/?ai=1\"",
    "load-journey": "npm install && node scripts/load-saved-journey.mjs",
    "editor": "npm install && npm run dev:vite -- --open /editor",
    "editor2": "npm install && npm run dev:vite -- --open \"/editor?toml=data/cards.toml\"",
    "dreamsigns": "npm install && npm run dev:vite -- --open \"/dreamsigns?toml=data/dreamsigns.toml\"",
    "images": "npm install && npm run dev:vite -- --open /images",
    "start": "node scripts/dev-with-emulator.mjs",
    "dev": "node scripts/dev-with-emulator.mjs",
    "dev:vite": "node scripts/prepare-workspace.mjs && vite --port 5173 --strictPort",
    "build": "node scripts/prepare-workspace.mjs && tsc && vite build",
    "preview": "vite preview",
    "lint": "node scripts/review.mjs lint",
    "lint:full": "node scripts/review.mjs lint-full",
    "test": "node scripts/review.mjs test",
    "test:full": "node scripts/review.mjs test-full",
    "typecheck": "node scripts/review.mjs typecheck",
    "validate": "node scripts/review.mjs validate",
    "review": "node scripts/review.mjs quick",
    "review:full": "node scripts/review.mjs full",
    "format:ron": "node scripts/format-ron.mjs",
    "format:ron:check": "node scripts/format-ron.mjs --check",
    "trox:sync-runtime": "node scripts/sync-trox-runtime.mjs",
    "trox:bump": "node scripts/bump-trox.mjs",
    "trox:check": "node scripts/trox-source-workspace.mjs",
    "trox:check-artifacts": "node scripts/trox.mjs check",
    "trox:check-runtime": "node scripts/sync-trox-runtime.mjs --check",
    "trox:check-generated": "node scripts/trox-generated-check.mjs",
    "trox:check-source": "node scripts/trox-source-workspace.mjs",
    "trox:release": "npm run prepare-workspace && npm run trox:extract && npm run trox:check-artifacts -- --deny warnings && npm run trox:bundle -- --allow-missing && npm run trox:check-generated",
    "trox:audit-canonical": "node scripts/canonical-localization-audit.mjs",
    "trox:extract": "node scripts/trox.mjs extract",
    "trox:bundle": "node scripts/trox.mjs bundle",
    "game-data:compile": "node scripts/game-data-pipeline.mjs compile",
    "game-data:check": "node scripts/game-data-pipeline.mjs check",
    "game-data:list": "node scripts/game-data-pipeline.mjs list",
    "game-data:rust-test": "cargo test --locked --manifest-path tools/game-data/Cargo.toml",
    "game-data:clean-test": "node scripts/game-data-clean-checkout-test.mjs",
    "game-data:parity": "node scripts/game-data-parity.mjs",
    "tabula": "npm --prefix tabula install && npm --prefix tabula run tauri dev",
    "tabula:check": "npm --prefix tabula run check",
    "tabula:test:e2e": "npm --prefix tabula run test:e2e:native",
    "tabula:dev": "npm --prefix tabula run tauri dev",
    "setup-assets": "node scripts/setup-assets.mjs",
    "prepare-workspace": "node scripts/prepare-workspace.mjs",
    "cumulus-tokens": "node scripts/generate-cumulus-tokens.mjs",
    "cumulus-metadata": "node scripts/generate-cumulus-metadata.mjs",
    "cumulus-docs": "node scripts/prepare-workspace.mjs && node scripts/generate-cumulus-docs.mjs",
    "audit:player-localization": "node scripts/audit-player-localization.mjs --check",
    "audit:domain-strings": "node scripts/domain-string-audit.mjs",
    "audit:amplified-designs": "node scripts/audit-amplified-designs.mjs",
    "upload-assets": "node scripts/upload-assets-to-storage.mjs",
    "publish-dda-image": "node .llms/skills/dda/scripts/publish-image.mjs",
    "send-screenshots": "node scripts/send-screenshots-to-discord.mjs",
    "device-screenshots": "node scripts/device-screenshots.mjs",
    "screenshots:desktop": "node scripts/desktop-screenshots.mjs",
    "compare-cumulus-scene": "bash cumulus/scripts/compare-scene.sh",
    "open-cumulus-scene-comparison": "bash cumulus/scripts/open-scene-comparison.sh",
    "deploy": "bash scripts/deploy.sh",
    "dev:status": "node scripts/dev-processes.mjs",
    "dev:stop": "node scripts/dev-processes.mjs --stop",
    "kill-dev-servers": "node scripts/dev-processes.mjs --stop --all",
    "regenerate-replay-fixtures": "tsx --import=./scripts/register-raw-import-loader.mjs scripts/regenerate-replay-fixtures.mjs",
    "fuzz:coop": "tsx --import=./scripts/register-raw-import-loader.mjs scripts/coop-fuzz.mts",
    "fuzz:demo": "node scripts/fuzz-demo.mjs",
    "fuzz:demo:built": "node scripts/fuzz-demo.mjs --built --profile smoke --runs 1",
    "fuzz:replay": "node scripts/replay-fuzz.mjs",
    "demo:certify": "npm run fuzz:coop -- --runs 500 && npm run fuzz:demo:built",
    "generate-selected-encounters": "node scripts/setup-assets.mjs && node scripts/generate-selected-encounters-toml.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@trox/runtime": "file:vendor/trox-runtime",
    "firebase": "^12.13.0",
    "framer-motion": "^12.6.3",
    "js-sha256": "^0.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@noble/hashes": "^2.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.6.0",
    "brace-expansion": "file:vendor/brace-expansion",
    "eslint": "^9.39.2",
    "fast-check": "^4.9.0",
    "firebase-tools": "15.24.0",
    "jsdom": "^29.0.2",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "react-docgen-typescript": "^2.4.0",
    "smol-toml": "^1.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "@hono/node-server": "2.0.12",
    "@google-cloud/pubsub": "5.0.0",
    "morgan": "1.11.0",
    "firebase-tools": {
      "uuid": "11.1.1",
      "universal-analytics": {
        "uuid": "14.0.0"
      }
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
