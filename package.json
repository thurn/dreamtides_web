{
  "name": "quest-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "launch": "npm install && npm start -- --open",
    "qai": "npm install && npm start -- --open \"/?ai=1\"",
    "load-quest": "npm install && node scripts/load-saved-quest.mjs",
    "editor": "npm install && npm run dev:vite -- --open /editor",
    "editor2": "npm install && npm run dev:vite -- --open \"/editor?toml=data/tabula/cards_v2.toml\"",
    "dreamsigns": "npm install && npm run dev:vite -- --open \"/dreamsigns?toml=data/tabula/dreamsigns.toml\"",
    "images": "npm install && npm run dev:vite -- --open /images",
    "start": "node scripts/dev-with-emulator.mjs",
    "dev": "node scripts/dev-with-emulator.mjs",
    "dev:vite": "node scripts/setup-assets.mjs && vite --port 5173 --strictPort",
    "build": "node scripts/setup-assets.mjs && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:emulator": "PATH=/opt/homebrew/opt/openjdk@21/bin:/usr/local/opt/openjdk@21/bin:$PATH firebase emulators:exec --only database --project demo-quest-prototype \"vitest run src/multiplayer/firebase-emulator.integration.test.ts\"",
    "typecheck": "tsc --noEmit",
    "setup-assets": "node scripts/setup-assets.mjs",
    "regenerate-assets": "bash scripts/regenerate-assets.sh",
    "generate-pool": "node scripts/generate-color-pool.mjs",
    "simulate-pools": "node scripts/simulate-dreamcaller-pools.mjs",
    "pool-metrics": "node scripts/pool-metrics.mjs",
    "draft-replay-metric": "node scripts/draft-replay-experiment.mjs",
    "opponent-coherence-metric": "node scripts/opponent-coherence-experiment.mjs",
    "bake-affinity-corpus": "node scripts/bake-affinity-corpus.mjs",
    "affinity-corpus-parity": "node scripts/affinity-corpus-parity.mjs",
    "bake-merchant-corpus": "node scripts/bake-merchant-corpus.mjs",
    "merchant-corpus-parity": "node scripts/merchant-corpus-parity.mjs",
    "merchant-metric": "node scripts/setup-assets.mjs && vite-node scripts/merchant-experiment.ts",
    "bake-tides": "node scripts/bake-tides.mjs",
    "bake-tides2": "node scripts/bake-tides.mjs --out data/tides2.jsonc --doc docs/cards2/tides2_decklists.md --tide-size 70",
    "seed-tide-relationships": "node scripts/seed-tide-relationships.mjs",
    "bake-tides3": "node scripts/bake-tides3.mjs",
    "bake-tides4": "node scripts/bake-tides4.mjs",
    "check-tides4": "node scripts/check-tides4.mjs",
    "tides-similarity": "node scripts/tides-similarity-experiment.mjs",
    "bake-draft-records": "node scripts/rebuild-adapted-draft-records.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "firebase": "^12.13.0",
    "framer-motion": "^12.6.3",
    "js-sha256": "^0.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.2",
    "firebase-tools": "^15.18.0",
    "jsdom": "^29.0.2",
    "smol-toml": "^1.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "firebase-tools": {
      "uuid": "11.1.1",
      "universal-analytics": {
        "uuid": "14.0.0"
      }
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
