// Journey site presentation, placement, random-site behavior, and shared card choices.

#![enable(implicit_some)]
SitesCatalog(
  selection: (min_deck_for_purge: 8, placeable_types: [Shop, Purge, Transfiguration, Duplication]),

  site_types: [
    SiteMetadata(
      site: Battle,
      icon: "bxf bx-sword-alt",
      glossary_id: "85ffab8d-f972-4340-9b45-99f6aff6ccec",
      presentation: Battle(
        label: Tx("Battle"),
        final_boss_label: Tx("Final Boss"),
        locked_guidance: Tx("You must visit the other sites in this dreamscape first."),
      ),
    ),

    SiteMetadata(
      site: Draft,
      icon: "bxf bx-rectangle-vertical",
      glossary_id: "1ee13681-1ff5-431c-94a1-3390d45e1717",
      presentation: Draft(label: Tx("Draft {{pickCount}}x")),
    ),

    SiteMetadata(
      site: Shop,
      icon: "bxf bx-store-alt-2",
      glossary_id: "25f28ed1-5729-4240-a352-80f92fce530c",
      presentation: Shop(
        title: Tx("Dream Market"),
        restocked: Tx("Restocked"),
        restock_offers_action: Tx("Restock Offers"),
        restock_action: Tx("Restock"),
        free_price: Tx("Free"),
      ),
    ),

    SiteMetadata(
      site: Purge,
      icon: "bxf bx-hot",
      glossary_id: "4873bddf-7bf5-41e8-979e-36eb193db5a6",
      presentation: Purge(
        title: Tx("Purge Cards"),
        instruction: Tx("Choose any number of cards to remove from your deck for an essence cost"),
        purge_action: Tx("Purge {{count}}"),
      ),
    ),

    SiteMetadata(
      site: Essence,
      icon: "bxf bx-diamond-alt",
      glossary_id: "ba8ea132-f636-4fed-be27-e8eff0c9cb07",
    ),

    SiteMetadata(
      site: Transfiguration,
      icon: "fa-solid fa-hammer",
      glossary_id: "7ae25c1a-76c5-4aed-9e1c-a2d5ec160bd7",
    ),

    SiteMetadata(
      site: Duplication,
      icon: "bxf bx-copy",
      glossary_id: "8222c5e2-a3ce-4caf-bd13-5c77ff15d7cf",
      rules: Duplication(
        // Select eligible entries from the player's current deck.
        // Standard sites offer three candidates; enhanced sites expose every eligible entry.
        card_choices: CardChoiceLimits(standard: Count(3), enhanced: All),
      ),
    ),

    SiteMetadata(
      site: Reward,
      icon: "bxf bx-treasure-chest",
      glossary_id: "28925242-3799-4faa-b4bd-b8aac52ca442",
    ),

    SiteMetadata(
      site: Augury,
      icon: "bxf bx-eye",
      glossary_id: "ffd3977a-a463-4326-bdf2-5b1b8c3d9160",
    ),

    SiteMetadata(
      site: DreamsignBazaar,
      icon: "bxf bx-pyramid",
      glossary_id: "5b5b47d6-c858-4b42-af96-a520c84666eb",
      presentation: DreamsignBazaar(
        title: Tx("Dreamsign Bazaar"),
        restocked: Tx("Restocked"),
        restock_offers_action: Tx("Restock Offers"),
        restock_action: Tx("Restock"),
        free_price: Tx("Free"),
        replacement_title: Tx("Choose a Dreamsign to Replace"),
      ),
    ),

    SiteMetadata(
      site: DreamsignRevelation,
      icon: "bxf bx-meteor",
      glossary_id: "ac70fd6b-a91a-407f-b7b7-255668cd6bec",
      presentation: DreamsignRevelation(
        loading: Tx("Revealing Dreamsigns..."),
        exhausted: Tx("The Dreamsign pool is exhausted."),
      ),
    ),

    SiteMetadata(
      site: RandomSite,
      icon: "fa-solid fa-question",
      glossary_id: "1aeb05bc-53e1-4ea4-9e73-9239160799dc",
      presentation: RandomSite(title: Tx("Choose a Site")),
    ),

    SiteMetadata(
      site: Gamble,
      icon: "bxf bx-coin",
      glossary_id: "f1ff2fb5-3d77-4eb8-b492-78cbe11fd265",
    ),

    SiteMetadata(
      site: Exploration,
      icon: "bxf bx-compass",
      glossary_id: "46059d35-cb9e-4c4b-8635-087b6239f308",
    ),
  ],

  random_site: RandomSiteRules(
    destinations: [
      Shop,
      DreamsignBazaar,
      DreamsignRevelation,
      Transfiguration,
      Duplication,
      Purge,
      Augury,
      Gamble,
      Exploration,
    ],
    home_choice_count: 3,
  ),
)
