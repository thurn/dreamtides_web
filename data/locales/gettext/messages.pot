#. TRANSLATORS: Accessible name for the Journey status-bar control that opens the local player's deck. {count} is the non-negative deck size and can be zero.
#: src/cumulus/components/hud/JourneyStatusBar.tsx:541
msgid "View deck containing {count} Card"
msgid_plural "View deck containing {count} Cards"
msgstr[0] ""
msgstr[1] ""

#. TRANSLATORS: Accessible name for the full-screen browser containing the
#. current local player's deck, including in a cooperative room.
#. TRANSLATORS: Title of the full-screen browser for the current player's
#. deck. “Your” addresses the local player, including in a cooperative room.
#: src/cumulus/screens/DesktopDeckViewer.tsx:133
#: src/cumulus/screens/DesktopDeckViewer.tsx:275
msgid "Your Deck"
msgstr ""

#. TRANSLATORS: Count beneath the deck-browser title. {count} is the
#. non-negative number of cards currently in the player's deck and can be zero.
#: src/cumulus/screens/DesktopDeckViewer.tsx:278
msgid "{count} Card"
msgid_plural "{count} Cards"
msgstr[0] ""
msgstr[1] ""

#. TRANSLATORS: Accessible name for the icon-only control that dismisses the
#. deck browser and returns focus to the Journey screen beneath it.
#: src/cumulus/screens/DesktopDeckViewer.tsx:282
msgid "Close deck browser"
msgstr ""

#. TRANSLATORS: Empty state in the deck browser when the player's deck
#. contains zero cards.
#: src/cumulus/screens/DesktopDeckViewer.tsx:644
#: src/cumulus/screens/MobileDeckViewer.tsx:422
msgid "Your deck is empty."
msgstr ""

#. TRANSLATORS: Empty state when the player's non-empty deck has no cards
#. matching the active filter. The player can change or clear that filter.
#: src/cumulus/screens/DesktopDeckViewer.tsx:647
#: src/cumulus/screens/MobileDeckViewer.tsx:431
msgid "No cards match this filter."
msgstr ""
