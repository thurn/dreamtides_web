    ),

    TransfigurationFormDefinition(
      id: Perfected,
      glossary_uuid: "22adf539-d2c9-4f33-9416-159d03a220ad",
      name: "Perfected",
      effect_disclosure: "Apply every available transfiguration",
      selected_card_description: "Every eligible transfiguration is applied in canonical order.",
