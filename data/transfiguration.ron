      accent_color: "#d946ef",
      tint_color: "#f0abfc",
      display_order: 6,
      merchant_allowed: true,
      eligibility: NamedTrigger,
      operation: WidenNamedTrigger,
      pricing: Band(CostBand(base: 50, jitter: 30, floor: 20)),
      benefit: Flat(value: 0.5),
