    ),

    TransfigurationFormDefinition(
      id: Hastened,
      glossary_uuid: "19f6c2c9-dd6b-4d65-9f95-f6a3486772cc",
      name: "Hastened",
      effect_disclosure: "Make it Fast",
      selected_card_description: "It becomes Fast.",
      accessibility_description: "Makes this event Fast.",
