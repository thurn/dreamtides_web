      accent_color: "#a855f7",
      tint_color: "#d8b4fe",
      display_order: 8,
      merchant_allowed: false,
      eligibility: AtLeastEligibleForms(count: 2),
      operation: ApplyEligibleForms(
        form_order: [
          Empowered,
          Amplified,
          Kindled,
          Inspired,
          Enduring,
          Hastened,
          Resonant,
          Attuned,
        ],
