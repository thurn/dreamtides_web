    TransfigurationFormDefinition(
      id: Attuned,
      glossary_uuid: "980d283a-9558-4b66-84a0-fcb91fdf4ceb",
      name: "Attuned",
      effect_disclosure: "Reduce an activated ability's cost by 1●",
      selected_card_description: "An activated ability costs 1● less.",
      accessibility_description: "Reduces an activated ability's energy cost by one.",
      glyph: TransfigurationAttuned,
      accent_color: "#f43f5e",
      tint_color: "#fda4af",
