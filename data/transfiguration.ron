#![enable(implicit_some)]
TransfigurationCatalog(
  site: TransfigurationSite(
    rules_version: "transfiguration-v1",
    standard_choice_limit: Count(3),
    enhanced_choice_limit: All,
    pricing: TransfigurationPricing(
      minimum_cost: 0,
      maximum_cost: 100,
      step: 10,
      stat_delta_bands: [
        StatDeltaBand(
          minimum_delta: 1,
          maximum_delta: 1,
          band: CostBand(base: 10, jitter: 20, floor: 10),
        ),

        StatDeltaBand(
          minimum_delta: 2,
          maximum_delta: 2,
          band: CostBand(base: 30, jitter: 20, floor: 10),
        ),

        StatDeltaBand(
          minimum_delta: 3,
          maximum_delta: 3,
          band: CostBand(base: 50, jitter: 20, floor: 30),
        ),

        StatDeltaBand(
          minimum_delta: 4,
          maximum_delta: None,
          band: CostBand(base: 70, jitter: 20, floor: 50),
        ),
      ],
    ),
    form_order: [
      Empowered,
      Amplified,
      Kindled,
      Inspired,
      Enduring,
      Hastened,
      Resonant,
      Attuned,
      Perfected,
    ],
  ),

  forms: [
    TransfigurationFormDefinition(
      id: Empowered,
      glossary_uuid: "a66c513e-500b-4891-8c09-9641ae300ba4",
      name: "Empowered",
      effect_disclosure: "Halve its ● cost, rounded down",
      selected_card_description: "Its energy cost is halved, rounded down.",
      accessibility_description: "Reduces this card's energy cost by half, rounded down.",
      glyph: TransfigurationEmpowered,
      accent_color: "#10b981",
      tint_color: "#6ee7b7",
      display_order: 0,
      merchant_allowed: true,
      eligibility: PositiveEnergyCost,
      operation: HalveEnergyCost(rounding: Down, minimum: 0),
      pricing: StatDelta,
      benefit: Ratio(divisor: 2.0),
    ),

    TransfigurationFormDefinition(
      id: Amplified,
      glossary_uuid: "a2c070ca-eacd-4cca-b69d-3d48f0787a16",
      name: "Amplified",
      effect_disclosure: "Replace its ability with its authored stronger form",
      selected_card_description: "Its ability is replaced by its authored stronger form.",
      accessibility_description: "Replaces this card's rules with its authored amplified rules.",
      glyph: TransfigurationAmplified,
      accent_color: "#f59e0b",
      tint_color: "#fcd34d",
      display_order: 1,
      merchant_allowed: true,
      eligibility: DistinctAuthoredAmplifiedText,
      operation: UseAuthoredAmplifiedText,
      pricing: Band(CostBand(base: 10, jitter: 20, floor: 10)),
      benefit: Flat(value: 0.4),
    ),

    TransfigurationFormDefinition(
      id: Kindled,
      glossary_uuid: "f40df441-0e44-4122-b4d4-cdc4085a9ffb",
      name: "Kindled",
      effect_disclosure: "Double its ✦, or set it to 1 if it is 0",
      selected_card_description: "Its base spark is doubled, or set to 1 if it is 0.",
      accessibility_description: "Doubles this character's base spark, or sets zero spark to one.",
      glyph: TransfigurationKindled,
      accent_color: "#ef4444",
      tint_color: "#fca5a5",
      display_order: 2,
      merchant_allowed: true,
      eligibility: CardType(card_type: Character),
      operation: DoubleSpark(zero_result: 1),
      pricing: StatDelta,
      benefit: Ratio(divisor: 4.0),
    ),

    TransfigurationFormDefinition(
      id: Inspired,
      glossary_uuid: "f0ff63b4-424b-4ae9-81d5-a4f6546afa3f",
      name: "Inspired",
      effect_disclosure: "Add \"Draw a card\" to its rules text",
      selected_card_description: "Draw a card is appended to its rules text.",
      accessibility_description: "Adds Draw a card to this event's rules.",
      glyph: TransfigurationInspired,
      accent_color: "#3b82f6",
      tint_color: "#93c5fd",
      display_order: 3,
      merchant_allowed: true,
      eligibility: CardType(card_type: Event),
      operation: AppendRulesClause(clause: DrawCard),
      pricing: Band(CostBand(base: 20, jitter: 20, floor: 10)),
      benefit: Flat(value: 0.55),
    ),

    TransfigurationFormDefinition(
      id: Enduring,
      glossary_uuid: "eb4cfc5f-237a-47cd-9215-7cce3f15583f",
      name: "Enduring",
      effect_disclosure: "Add \"Reclaim\" to its rules text",
      selected_card_description: "Reclaim is appended to its rules text.",
      accessibility_description: "Adds Reclaim to this event's rules.",
      glyph: TransfigurationEnduring,
      accent_color: "#6366f1",
      tint_color: "#a5b4fc",
      display_order: 4,
      merchant_allowed: true,
      eligibility: CardType(card_type: Event),
      operation: AppendRulesClause(clause: Reclaim),
      pricing: Band(CostBand(base: 50, jitter: 30, floor: 20)),
