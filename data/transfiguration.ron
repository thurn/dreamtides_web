      display_order: 5,
      merchant_allowed: true,
      eligibility: EventWithoutFast,
      operation: SetFast,
      pricing: Free,
      benefit: Flat(value: 0.5),
    ),

    TransfigurationFormDefinition(
      id: Resonant,
      glossary_uuid: "c3fa83af-ee3b-47cd-8112-5e5cc38821de",
      name: "Resonant",
      effect_disclosure: "Widen a named trigger to fire more often",
      selected_card_description: "A named trigger fires more often.",
      accessibility_description: "Widens a named trigger on this card to fire more often.",
