// Defines the shared Dreamwell's construction rules and card catalog.
//
// Both players draw from the same seeded deck. Each drawn card permanently
// increases that player's maximum energy by `energy_added`, then resolves the
// player-facing rules in `ability_text`.

#![enable(implicit_some)]
DreamwellCatalog(
  // Controls how the shared deck is assembled from each card's `deck_tier`.
  // Cards are shuffled only within their tier, using the battle's deterministic
  // Dreamwell RNG stream.
  rules: DreamwellRules(
    // Tiers included in full, once, at the front of the first cycle. `Starting`
    // cards lower to compatibility order 0, so every Starting card appears once.
    opening_orders: [0],
    // Tiers sampled in order for the first and every later cycle. Numbered
    // tiers One through Four lower to compatibility orders 1 through 4.
    recurring_orders: [1, 2, 3, 4],
    // Maximum cards sampled from each recurring tier per cycle. A smaller tier
    // contributes every available card; no card is duplicated within a cycle.
    cards_per_recurring_order: 5,
    // Complete cycles are appended until the prebuilt deck reaches at least
    // this many cards. The final cycle may take the deck beyond this threshold.
    minimum_constructed_length: 62,
  ),

  // Canonical card definitions. UUID is stable identity; names are display-only
  // and are not required to be unique. Source order is preserved in generated
  // data but deck construction groups cards by `deck_tier`.
  cards: [
    DreamwellCardDefinition(
      name: Tx("Dawning Horizon"),
      id: "32d64cb6-9856-43a2-9451-fcb14007a9a6",
      ability_text: [Tx("(no ability)")],
      // Permanently increases the drawing player's maximum energy by this amount.
      energy_added: 2,
      // Starting cards appear only in the first cycle; numbered tiers recur in ascending order.
      deck_tier: Starting,
      art: (image: 1963305268, owned: true),
    ),

    DreamwellCardDefinition(
      name: Tx("Sunrise Cavern"),
      id: "5e17dc4b-b654-4962-ba5a-7b042852a980",
      ability_text: [Tx("(no ability)")],
      energy_added: 2,
      deck_tier: Starting,
      art: (
        image: 565499323,
        owned: true,
        // Pan and zoom framing applied after the image fills the card frame.
        crop: (x: 1, y: 0, scale: 1),
      ),
    ),

    DreamwellCardDefinition(
      name: Tx("Meteor Meadow"),
      id: "5ec17498-9028-4a01-80a0-67c91b03d505",
      ability_text: [Tx("Draw a card.")],
      energy_added: 1,
