        {"id":"a952f833-825a-435f-82b1-8d85f872d274","name":"Virtuoso of Harmony","subtype":"Musician","text":"Abandon a ≤2● cost character: Gain 1●.","copies":1},
        {"id":"aba40bc6-3e9e-4874-be8a-6984cbf13146","name":"The Forsaker","subtype":"Renegade","text":"Abandon a ≤2● cost character: Gain 1⍟.","copies":1},
        {"id":"b6bad2a1-b857-4dd7-8b22-050eb68433a5","name":"Ferryman of the Falls","subtype":"Explorer","text":"▸Dawn: Abandon a character. Erode 1.\n\nWhen a ≤2● cost character is put into your void, draw a card.","copies":1},
