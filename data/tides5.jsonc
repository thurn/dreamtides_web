      "cards": [
        {"id":"b78d776b-15dd-4d0c-ad12-68b97b8d9fb6","name":"Starsea Traveler","subtype":"Explorer","text":"Once per turn, you may play a ≤2● cost character from your void.","copies":2},
        {"id":"017a7b4b-3ccf-4635-9956-28a72b22274e","name":"Wraith of Twisting Shadows","subtype":"Monster","text":"This character has +1✦ for each ≤2● cost character in your void.\n\n☪, Discard a card: Draw a ≤2● cost character.","copies":1},
        {"id":"09332e5b-3b4e-458f-9df0-3fc0419f65c3","name":"Unleash Ruin","text":"Dissolve a ≤3● cost enemy.","copies":1},
        {"id":"0d867086-8413-40c3-820f-1a5de486577e","name":"Fathomless Maw","subtype":"Ancient","text":"When you abandon a character, gain 1⍟.","copies":1},
        {"id":"16d2e85d-f940-43dd-9867-784b3a5ec5d7","name":"Stargazer Adrift","subtype":"Explorer","text":"Abandon another character: Foresee 1.","copies":1},
        {"id":"28c3ef90-c0dc-4b85-92c8-40758b99e0ce","name":"Petal-Seer","subtype":"Visitor","text":"With 3 or more allied characters, reveal the top card of your deck. You may play characters from the top of your deck.","copies":1},
        {"id":"3e6a5236-9850-4a69-9fe1-48389365a399","name":"Dusk Duelist","subtype":"Visitor","text":"▸Materialized: Dissolve a ≤2✦ enemy.","copies":1},
        {"id":"470bbf9d-a73c-4e00-bc66-cb0fa767c8de","name":"Depthwalker","subtype":"Explorer","text":"▸Materialized: Erode 4. You may return a ≤2● cost character from among those cards to your hand.","copies":1},
        {"id":"4ccb9bb6-e4db-48c3-a534-b0ab454f0f15","name":"Specter of Silent Snow","subtype":"Visitor","text":"▸Dawn: Abandon a character.\n\nWhen you abandon a character, draw a card and this character gains +1✦.","copies":1},
        {"id":"4cece464-2fde-483d-af92-04cd0341be5b","name":"Collateral Damage","text":"Dissolve each ≤X✦ character.","copies":1},
        {"id":"4edf2d8d-61e4-4c3a-a388-4b52b2ebd005","name":"Soulkindler","subtype":"Visitor","text":"Abandon this character: Return an character from your void to your hand.\n\n▸Dawn: If this card is in your void, erode 3.","copies":1},
        {"id":"6af8cf81-9e9e-481f-b518-f5dadad99b27","name":"Winterbough Monk","subtype":"Explorer","text":"▸Materialized: Return a card from your void to your hand.","copies":1},
        {"id":"70306382-ac0d-4b08-843a-23efb3835c94","name":"First Encounter","text":"Materialize all characters in your void which were discarded this turn.\n\nWhen you discard this card, it gains reclaim 0●.","copies":1},
        {"id":"72debe2e-1f47-4a66-83c3-71bb72876663","name":"Wake the Fallen","text":"Materialize all characters in your void which dissolved this turn.","copies":1},
        {"id":"7977748d-02c1-4702-ba68-5c49f7f0759b","name":"Light of Emergence","subtype":"Visitor","text":"☪, Abandon a ≤2● cost character: Materialize a random ≤2● cost character from your deck. This character gains +1✦.","copies":1},
        {"id":"7dd2214f-8d16-453a-9f28-62712e64eae1","name":"Ambersting","subtype":"Spirit Animal","text":"Vengeful\n\n▸Dawn: Gain 1●.","copies":1},
        {"id":"8624f9c7-dc92-4f4a-9c79-319b9c121b19","name":"Cinderheart","subtype":"Visitor","text":"When you abandon a character, this character gains +1✦.\n\n▸Dissolved: Gain ⍟ equal to this character's ✦.","copies":1},
        {"id":"86881031-393f-4359-96f5-3adde6bdd74d","name":"Abomination of Memory","subtype":"Ancient","text":"This character has +4✦ if there are three or more ≤2● cost characters in your void.","copies":1},
        {"id":"87f075b1-b058-4570-a75f-c4f8f544e192","name":"Wondrous Clearing","subtype":"Visitor","text":"▸Materialized: You may materialize a ≤2● cost character from your hand.","copies":1},
        {"id":"8b5eb29c-146f-46fb-9407-55004128fba7","name":"Keeper of Forgotten Light","subtype":"Ancient","text":"When you materialize a non-figment ≤2● cost character, draw a card with ephemeral.","copies":1},
        {"id":"975f49d3-213a-43fc-8079-5fe40f126a7b","name":"Scrap Reclaimer","subtype":"Tinkerer","text":"Awakened, Veil 2●\n\n2●, ☪, Discard a card: Return up to 2 ≤2● cost characters from your void to your hand.","copies":1},
        {"id":"a5056a4c-542b-4a7c-8fe6-895126c7d4c8","name":"Carrion Lord","subtype":"Ancient","text":"When you abandon a ≤2● cost character, materialize a 4✦ monstrosity figment.\n\n4●: Abandon a ≤2● cost character.","copies":1},
