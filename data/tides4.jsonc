        {"id":"2690912e-0295-4d12-a603-5946d37902d3","name":"Call the Lost","text":"For each card you've played this turn, materialize a 2✦ shadow figment.\n\nReclaim 2●","copies":1},
        {"id":"2931e20b-1a80-4ddd-8944-20e68d182886","name":"Sunken Radiance","text":"Draw 2 cards, then discard 2 cards.\n\nReclaim 2●.","copies":1},
        {"id":"29c4c45d-33df-42ac-bf28-387eb00264aa","name":"Inheritor of Sorrows","subtype":"Synth","text":"If there are 3 or more events in your void, this character has +4✦ and gains awakened.","copies":1},
        {"id":"29d25251-8b42-4d3d-97e6-6c3abaabd9a2","name":"Blooming Horror","text":"Choose a player. For each card you've played this turn, that player erodes 2.","copies":1},
        {"id":"33874387-2490-48ed-93bc-a47a16e399ad","name":"Soulbinder","subtype":"Synth","text":"Abandon a character: Store 1⧗.\n\n2⧗: Gain 1●.","copies":1},
