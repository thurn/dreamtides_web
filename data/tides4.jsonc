        {"id":"3cda9dd7-cb81-43c1-9db5-1444d7363e13","name":"Spirit Bond","text":"Until end of turn, characters you control have +X✦ where X is the number of characters you control.","copies":2},
        {"id":"46783333-78f9-4146-a8ec-0d1b81e1bf2f","name":"Emerald Guardian","subtype":"Spirit Animal","text":"▸Materialized: Draw a card.\n\n▸Dawn: Gain 1●.","copies":2},
        {"id":"48257e3e-9600-4edf-a905-e73a41ab5ec1","name":"Flamboyant Flamingo","subtype":"Spirit Animal","text":"▸Dawn: Gain 1●.","copies":2},
        {"id":"4a8bdcd7-cf88-48d4-80d0-a83fd6617d81","name":"Portal of Twin Paths","text":"Materialize two random ≤2● cost characters from your deck.","copies":2},
        {"id":"4e3c04a9-1cdd-468a-b42a-40157ed9c9d6","name":"Eternal Stag","subtype":"Spirit Animal","text":"Support – Supported spirit animals have +1✦.\n\n2●, ☾: Draw a spirit animal.","copies":2},
        {"id":"61060827-8bed-4b63-b63d-6c3b0536e941","name":"Vigilant Howler","subtype":"Spirit Animal","text":"When you materialize a spirit animal, store 1⧗.\n\n3⧗: Gain 3●.","copies":2},
        {"id":"738a5af0-f848-4d48-bceb-9a43c9b11066","name":"Seeker of Lost Paths","subtype":"Suvivor","text":"Cards you reclaim are not banished when they leave play.\n\n2●, ☾: Choose a character in your void to gain reclaim.","copies":2},
