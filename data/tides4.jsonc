        {"id":"edb479be-68a5-45bc-bd19-2602156edb57","name":"Sunshadow Eagle","subtype":"Spirit Animal","text":"5●, ☾: The base ✦ of each spirit animal you control becomes 7 until end of turn.","copies":1},
