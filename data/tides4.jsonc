        {"id":"7d5672d2-c8fa-4837-9e98-8cccdd07ff56","name":"Twice-Lit Portal","text":"Offering\n\nThe next time you play an event this turn, copy it.","copies":2},
        {"id":"8896c178-757e-4775-b117-a4357ebfe30f","name":"Flameforged","subtype":"Visitor","text":"☾, Discard an event: Draw an event.\n\nThis character has +1✦ for each event in your void.","copies":2},
        {"id":"b4838d67-f055-4fd3-a64d-0a4d2b6678cc","name":"Thought Merchant","subtype":"Visitor","text":"Once per turn, when you discard a card, draw a card and gain 1●.","copies":2},
