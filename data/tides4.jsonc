        {"id":"34ea77a8-66e4-49b8-a934-a9d95cb74376","name":"Tidewreck Navigator","subtype":"Survivor","text":"☾, Discard a card: Materialize a 1✦ survivor figment.\n\n☾, Abandon a survivor: Return a survivor from your void to your hand.","copies":1},
        {"id":"37d9165f-2b3a-44a2-848b-401cf4466a7c","name":"Guide of Lost Souls","subtype":"Visionary","text":"When a character is dissolved, gain 1⍟.","copies":1},
        {"id":"409147ec-d959-4f66-b126-564702e2cd4a","name":"Veil of the Wastes","subtype":"Survivor","text":"When you materialize a ≤2● cost character, return this card from your void to play.","copies":1},
        {"id":"49641e8e-93a8-46cb-92a9-246b0fd57899","name":"Corrupted Host","subtype":"Survivor","text":"Abandon another character: This character gains +1✦.","copies":1},
