    {
      "id": "tide-neu-02",
      "name": "Broad: Celestial Reverie / Stoneborn Leviathan",
      "shortName": "Spirit Animal Draw",
      "displayName": "The Migration",
      "displayDescription": "Builds a wide pack of Spirit Animals fueled by drawing, then crushes with a single unified strike.",
      "summary": "Tide-neu-02 builds a wide board of cheap spirit animals fueled by Celestial Reverie's draw chain, then converts that board into a single crushing challenge with Spirit Bond — distinguishing itself from its nearest siblings by centering on the draw-per-character-played engine rather than duplicating board-wide ✦ support auras or token-spawning loops.",
      "description": "This tide is built almost entirely from spirit animal characters (23 of 30 cards) with a cluster of cheap 1-cost bodies — Ethereal Trailblazer, Blazebound Sentinel, Worldsong Behemoth — that each generate 1● on Dawn, letting the board snowball its own energy. The central draw engine is Celestial Reverie (present at 2 copies), a 1-cost event that converts every character played that turn into a card draw, enabling the kind of chain turns where playing one animal finds the next. Skyborne Jellyfish amplifies the energy side of that chain by generating 1● for each allied low-cost character at Dawn, while Dreamborne Leviathan spawns a 1✦ spirit animal figment each time a spirit animal is played, broadening the board further. The primary finisher is Spirit Bond, a 7-cost event that grants every allied character +X✦ where X equals the number of allies — rewarding exactly the wide boards this tide is designed to assemble. Compared to the closest sibling (tide-fac-13), which runs multiple copies of board-wide ✦ support pieces like Ghostlight Wolves and Eternal Stag alongside discovery tools like Shatterpoint Agent and Nexus Wayfinder, tide-neu-02 is a leaner, more focused package: it foregoes those duplicated aura supports and instead anchors the whole deck around Celestial Reverie's draw loop as the mechanism that assembles the army Spirit Bond needs.",
      "color": "green",
      "claims": {"tribe": "Spirit Animal", "mechanics": ["ramp"]},
      "role": "neutral",
      "leanCardId": "99ca2635-a91a-46ba-a9d3-4d2581c354f3",
      "cards": [
        {"id":"caaee8a9-0c22-41b4-950f-4c1131b98221","name":"Celestial Reverie","text":"Until end of turn, when you play a character, draw a card.","copies":2},
        {"id":"07ceb104-0b27-473a-bc72-e6225479ed83","name":"Stoneborn Leviathan","subtype":"Spirit Animal","text":"1●, Return a character you control to hand: Give a character you control +1✦.","copies":1},
        {"id":"0f1ac858-a28a-489b-9dd4-4d28f8f1abf5","name":"Cloudmantle Ray","subtype":"Spirit Animal","text":"▸Dawn: Gain 1● for each ≤2● cost character you control.","copies":1},
        {"id":"14ac6804-ed1d-4148-aad7-11796b6fff6c","name":"Luminwings","subtype":"Spirit Animal","text":"▸Dawn: Gain 1●. If you control 3 or more spirit animals, gain 2● instead.","copies":1},
        {"id":"151b80b1-0a3f-48d4-9c85-99a9c274fd7f","name":"Ethereal Army","text":"Materialize X 1✦ ethereal figments.","copies":1},
