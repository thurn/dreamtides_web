        {"id":"4ee2f0a5-c35c-4b5e-a0be-de5ef3e8639e","name":"Phantom Angler","subtype":"Ancient","text":"☾: Choose a ≤2● cost character in your void to gain reclaim.","copies":1},
        {"id":"6b739127-1a23-4c5d-877a-8829dd7a8b8c","name":"Entropy Spike","subtype":"Survivor","text":"▸Dissolved: Choose one: Gain 1●, or gain 1 maximum ●.","copies":1},
        {"id":"73fc1b7f-3c2b-4993-9590-924240515c2f","name":"Lunar Hart","subtype":"Spirit Animal","text":"▸Materialized, Dawn: Gain 2●.","copies":1},
