        {"id":"f38ab9b6-bea7-4c6e-b5db-2609796ba46b","name":"Dawnprowler","subtype":"Spirit Animal","text":"When you materialize a spirit animal, if it is not the first spirit animal you have materialized this turn, gain 1●.","copies":1},
        {"id":"fb41a90e-279c-419c-80fc-7c3469ba0c74","name":"Lord of Hidden Paths","subtype":"Spirit Animal","text":"Spirit animals you control have +1✦.\n\nWhen you play a spirit animal, you may pay 1● to draw a card.","copies":1},
        {"id":"fcb830e5-85ff-48f3-be1e-46e102a5c8e8","name":"Scrap Reclaimer","subtype":"Tinkerer","text":"▸Materialized: You may discard a card to discover a character with cost greater than that card's cost.","copies":1}
