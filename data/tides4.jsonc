        {"id":"48257e3e-9600-4edf-a905-e73a41ab5ec1","name":"Ethereal Trailblazer","copies":1},
        {"id":"4a8bdcd7-cf88-48d4-80d0-a83fd6617d81","name":"Roots of Rebirth","copies":1},
