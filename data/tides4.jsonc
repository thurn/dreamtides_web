        {"id":"faadc87f-98fe-4a58-b1a9-a7c0cff70e08","name":"Mnemonic Operator","subtype":"Visitor","text":"2●, ☾: Draw a card, then discard a card.\n\nWhen you discard a card, gain 1⍟.","copies":1}
