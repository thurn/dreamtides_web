        {"id":"07ceb104-0b27-473a-bc72-e6225479ed83","name":"Stoneborn Leviathan","subtype":"Spirit Animal","text":"1●, Return a character you control to hand: Give a character you control +1✦.","copies":2},
        {"id":"0f1ac858-a28a-489b-9dd4-4d28f8f1abf5","name":"Cloudmantle Ray","subtype":"Spirit Animal","text":"▸Dawn: Gain 1● for each ≤2● cost character you control.","copies":2},
        {"id":"14ac6804-ed1d-4148-aad7-11796b6fff6c","name":"Luminwings","subtype":"Spirit Animal","text":"▸Dawn: Gain 1●. If you control 3 or more spirit animals, gain 2● instead.","copies":2},
        {"id":"151b80b1-0a3f-48d4-9c85-99a9c274fd7f","name":"Ethereal Army","text":"Materialize X 1✦ ethereal figments.","copies":2},
        {"id":"18ff6a45-148a-40bf-85ae-4a51f32f406a","name":"Blazing Emberwing","subtype":"Spirit Animal","text":"☾: Gain 1● for each character you control.","copies":2},
