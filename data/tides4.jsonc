        {"id":"8624f9c7-dc92-4f4a-9c79-319b9c121b19","name":"Cinderheart","subtype":"Visitor","text":"When you abandon a character, this character gains +1✦.\n\n▸Dissolved: Gain ⍟ equal to this character's ✦.","copies":1},
        {"id":"8a971ba7-9dfb-45be-bfbb-bf5e4f11974a","name":"Cost of Victory","text":"You may discard a card as an additional cost to play this event. Dissolve a ≤2● cost enemy. If the additional cost was paid, dissolve any enemy instead.","copies":1},
        {"id":"97b359ee-5a7a-4f54-bd65-e6221a893208","name":"Pyrokinetic Surge","text":"To play this card, discard a card or pay 5⍟. Dissolve an enemy.","copies":1},
        {"id":"a6866438-3632-408d-b464-c10f8a43a5c2","name":"Blight Weaver","subtype":"Visitor","text":"When you abandon a character, store 1⧗.\n\nX⧗: Dissolve an enemy with X✦.","copies":1},
