        {"id":"2e8571c0-4faf-4e7a-a702-26952d2035ee","name":"Watcher in the Ruins","subtype":"Survivor","text":"When a non-figment character you control is dissolved, draw a card.","copies":1},
        {"id":"37d9165f-2b3a-44a2-848b-401cf4466a7c","name":"Guide of Lost Souls","subtype":"Visionary","text":"When a character is dissolved, gain 1⍟.","copies":1},
        {"id":"49641e8e-93a8-46cb-92a9-246b0fd57899","name":"Corrupted Host","subtype":"Survivor","text":"Abandon another character: This character gains +1✦.","copies":1},
        {"id":"60feb0d0-89b8-48fc-b01a-ce54e2c9941f","name":"Twilight Suppressor","subtype":"Warrior","text":"When you play a character, store 1⧗.\n\n1⧗, Abandon a character: Gain 1⍟.","copies":1},
        {"id":"6b739127-1a23-4c5d-877a-8829dd7a8b8c","name":"Entropy Spike","subtype":"Survivor","text":"▸Dissolved: Choose one: Gain 1●, or gain 1 maximum ●.","copies":1},
        {"id":"7b55efd1-6d9f-4156-9de7-1c71ccc410cb","name":"Stolen Genesis","text":"To play this card, abandon a character. Materialize a random character with higher cost from your deck.\n\nReclaim 3●","copies":1},
        {"id":"7ffb1179-6c94-4f80-9613-ece2b799f19d","name":"Headtaker","subtype":"Ancient","text":"Veil\n\nAbandon a character: Gain 1⍟.","copies":1},
        {"id":"8571d7b3-5401-4678-9e81-e14538c8c46e","name":"Iconoclast","subtype":"Mage","text":"When you play a character, erode 1.\n\nReclaim 2●","copies":1},
        {"id":"8624f9c7-dc92-4f4a-9c79-319b9c121b19","name":"Cinderheart","subtype":"Visitor","text":"When you abandon a character, this character gains +1✦.\n\n▸Dissolved: Gain ⍟ equal to this character's ✦.","copies":1},
        {"id":"9d63ba3e-fafb-466e-8418-ce5f8941ba30","name":"Haunted Mariner","subtype":"Visitor","text":"▸Night: If you control no shadow figments, materialize a 2✦ shadow figment.","copies":1},
        {"id":"a7c2ee76-48c9-4587-8f01-81d00ae280cb","name":"Defiant Holdout","subtype":"Survivor","text":"▸Dissolved: Materialize X 1✦ survivor figments, where X is this character's ✦.","copies":1},
        {"id":"b56b3411-50c7-4cc9-90e0-d4ffcaec73c6","name":"Exiles of the Last Light","subtype":"Survivor","text":"Abandon another character: Gain 1●. The opponent gains 1⍟.","copies":1},
        {"id":"c36e67ab-fbee-4d83-b57b-34d34f60e17c","name":"Shadowsinger","subtype":"Visitor","text":"When a character you control is dissolved, materialize a 1✦ survivor figment. When you discard or erode this card, it gains reclaim 0●.","copies":1},
        {"id":"f3f97e2c-3bb6-4a20-9880-f59c50e5af93","name":"Eviscerator of Hope","subtype":"Ancient","text":"Abandon a character: Store 1⧗.\n\nX⧗: Dissolve an enemy with X✦.","copies":1},
        {"id":"f7084ba7-8c85-4847-80df-b0c98ec77d78","name":"Ghostcaller","subtype":"Visitor","text":"▸Dawn: Give a wraith you control +1✦. If you control no wraiths, materialize a 0✦ wraith figment with vengeful instead.","copies":1},
        {"id":"fbf725ca-8837-46d4-970c-922153e27b6e","name":"Infernal Ascendant","subtype":"Monster","text":"Abandon another character: Gain 1●.","copies":1},
        {"id":"ffec9fdd-d948-4756-b7df-39b9e982613e","name":"Skull Weaver","subtype":"Ancient","text":"When a character you control leaves play, gain 1⍟.","copies":1}
      ]
