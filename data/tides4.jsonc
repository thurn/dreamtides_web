        {"id":"331e2846-85d1-4667-8c64-dc6c21a418ed","name":"Beacon of Tomorrow","text":"Choose a value of X. Discover a character with cost X●.","copies":1},
        {"id":"3cda9dd7-cb81-43c1-9db5-1444d7363e13","name":"Spirit Bond","text":"Until end of turn, characters you control have +X✦ where X is the number of characters you control.","copies":1},
        {"id":"48257e3e-9600-4edf-a905-e73a41ab5ec1","name":"Flamboyant Flamingo","subtype":"Spirit Animal","text":"▸Dawn: Gain 1●.","copies":1},
        {"id":"4e3c04a9-1cdd-468a-b42a-40157ed9c9d6","name":"Eternal Stag","subtype":"Spirit Animal","text":"Support – Supported spirit animals have +1✦.\n\n2●, ☾: Draw a spirit animal.","copies":1},
        {"id":"61060827-8bed-4b63-b63d-6c3b0536e941","name":"Vigilant Howler","subtype":"Spirit Animal","text":"When you materialize a spirit animal, store 1⧗.\n\n3⧗: Gain 3●.","copies":1},
        {"id":"7992dbb5-ca45-4066-aca3-ff1d6d87619e","name":"Moonbound Wolf","subtype":"Spirit Animal","text":"Awakened\n\n☾, Return a character you control to hand: Trigger the 'Dawn' ability of a spirit animal you control.","copies":1},
        {"id":"7f550d4e-c6a1-4e5e-ae0c-1b3edd6f0f4a","name":"Ethereal Courser","subtype":"Spirit Animal","text":"When you play a spirit animal, return this character to hand. It costs 0● this turn.","copies":1},
