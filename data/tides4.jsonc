        {"id":"1434440c-c86f-4b7d-83e7-3bd1f7dde63e","name":"Pulse of Sacrifice","text":"Discard your hand. Gain 3●.","copies":1},
        {"id":"1750c85c-f547-4d21-b7e3-9e5c5fcb3171","name":"Sunrise Virtuoso","subtype":"Musician","text":"When you materialize a character, trigger its \"▸Dawn\" ability.","copies":1},
