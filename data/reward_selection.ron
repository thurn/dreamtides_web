// Defines shared tuning for selecting card, Dreamsign, transfiguration, purge, and site rewards.

#![enable(implicit_some)]
RewardSelectionCatalog(
  rules_version: V1,

  bands: SelectionBands(
    // The fraction of ranked candidates retained before enforcing the minimum band size.
    default: (fraction: 0.25, minimum: 5),
    strong_card: (fraction: 0.15, minimum: 5),
    dreamsign: (fraction: 0.4, minimum: 5),
  ),

  eligibility: EligibilityRules(
    min_deck_for_fit: 6,
    min_deck_for_purge: 8,
    purge_misfit_fraction: 0.2,
    starter_purge_bonus: 0.25,
    subtype_min_pool_cards: 12,
  ),

  bundle: BundleRules(
    // Candidate bundles grow from this many top-ranked cards at a time.
    growth_band_size: 5,
  ),

  blends: SelectionBlends(
    strong_card: (fit: 0.7, quality: 0.3),
    copies_draft: (fit: 0.6, quality: 0.4),
    duplicate: (quality: 0.5, fit_leave_one_out: 0.5),
    transfiguration: (benefit: 0.7, centrality: 0.3),
    bundle: (seed: 0.5, bundle: 0.3, fit: 0.2),
  ),

  categories: CategoryRules(affine_weight: 0.75, deck_affine_minimum: 2, cluster_affine_minimum: 1),

  centrality: CentralityRules(
    prior_weight: 0.65,
    cooccurrence_weight: 0.35,
    fallback: 0.25,
    spark_threshold: 3,
    spark_bonus: 0.15,
  ),

  dreamsign: DreamsignRules(
    full_coverage_count: 3,
    featureless_coverage: 0.4,
    quality_weights: [
      (quality: One, weight: 1.2),
      (quality: Two, weight: 1.0),
      (quality: Three, weight: 0.8),
    ],
  ),

  cost_bands: CostBandRules(
    cheap_maximum: 1,
    mid_minimum: 2,
    mid_maximum: 3,
    big_minimum: 4,
    cheap_character_maximum: 2,
  ),

  site: SiteRules(placeable_types: [Shop, Purge, Transfiguration, Duplication]),
)
