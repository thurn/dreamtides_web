// Opponent difficulty progression and deck-generation tuning.
//
// Layer values are zero-indexed Atlas completion levels: layer 0 is the first
// battle and the final layer is `layer_count - 1`. Curve endpoints are sampled
// at those two ends and linearly interpolated between them.
//
// Shared battle setup belongs to battle.ron. Dreamwell cards and construction
// rules belong to dreamwell.ron. Automated-play search tuning and the journey
// AI deck belong to internal/internal_ai.ron.

#![enable(implicit_some)]
OpponentsCatalog(
  // Journey opponent difficulty schedule. Ability and Dreamsign unlocks apply
  // to every opponent; Legendary retention and Starter dilution tune decks.
  progression: ProgressionRules(
    // The opponent DreamAvatar's ability is inactive below this layer.
    ability_active_from_layer: 1,
    // Opponents receive one deterministically selected Dreamsign from this
    // layer onward, provided Dreamsign templates are available.
    dreamsigns_from_layer: 3,
    // Opponent decks replace Legendary cards below this layer and retain them
    // from this layer onward.
    legendaries_from_layer: 5,
    // Number of Starter cards inserted by layer tuning. The
    // least-synergistic non-Starters are cut first, preserving deck size.
    // Layers beyond this list insert zero Starters.
    starter_dilution: [10, 5],
  ),

  // Selects a known-good deck from the adapted corpus, then applies the shared
  // progression rules above. Candidate ranking is deterministic; seeded
  // sampling inside the top-ranked window provides variety between battles.
  corpus_selection: CorpusSelectionRules(
    // Secondary multiplier for Dreamscape-affiliation fit. DreamAvatar
    // signature-card fit is the primary unweighted selection signal.
    affiliation_weight: 0.25,
    // Number of highest-ranked corpus decks eligible for seeded sampling.
    // When the corpus is smaller, every ranked deck remains eligible.
    top_ranked_sampling_window: 8,
  ),
)
