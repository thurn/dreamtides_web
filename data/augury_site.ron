// Augury encounter rules and offer abilities.

#![enable(implicit_some)]
AuguryCatalog(
  encounter: (
    // Allows the player to leave without accepting either offer.
    allow_decline: true,
  ),

  selection: (
    subtype_min_pool_cards: 12,
    cost_bands: (
      cheap_maximum: 1,
      mid_minimum: 2,
      mid_maximum: 3,
      big_minimum: 4,
      cheap_character_maximum: 2,
    ),
  ),

  archetypes: [
    AuguryArchetypeDefinition(
      id: "77ad1a09-aba0-4875-b462-e6efe94bdc3d",
      // Internal label used by debugging and authoring tools.
      name: "Grant: Fit card (gift)",
      // Player-facing offer copy. Placeholders resolve from the surfaced reward.
      presentation: (
        headline: Text(Tx("Gain a Card")),
        subtitle: Text(Tx(text: "Gain {card_name}", placeholders: {"card_name": Opaque})),
      ),
      // Effect of this reward offer. A `selection_policy` ranks eligible
      // targets for the ability.
      ability: FitCardGrant(selection_policy: CardFit, granted_copies: 1),
      // Relative selection weight among eligible definitions.
      weight: 10,
    ),

    AuguryArchetypeDefinition(
      id: "8f8db592-b62c-414e-9195-68641722cf50",
      name: "Grant: Fit card draft",
      presentation: (
        headline: Text(Tx("Choose a Card")),
        subtitle: Text(Tx("Choose a card to add to your deck.")),
      ),
      ability: FitCardDraft(selection_policy: CardFit, chooser_size: 4, granted_copies: 1),
      weight: 10,
    ),

    AuguryArchetypeDefinition(
      id: "b4ccca83-2a1d-4474-ba6d-4b95aefeed9b",
      name: "Grant: Copies draft",
      presentation: (
        headline: Text(Tx("Choose a Card")),
        subtitle: Count(
          one: Tx(
            text: "Choose a card and add {count} copy of it to your deck.",
            placeholders: {"count": Scalar},
          ),
          other: Tx(
            text: "Choose a card and add {count} copies of it to your deck.",
            placeholders: {"count": Scalar},
          ),
        ),
      ),
      ability: CopiesDraft(selection_policy: CardFitQuality, chooser_size: 4, granted_copies: 2),
      weight: 6,
    ),

    AuguryArchetypeDefinition(
      id: "c4ac3d68-e814-43ea-9be3-ced3fd1bbe89",
      name: "Grant: Strong card",
      presentation: (
        headline: Text(Tx("Gain a Card")),
        subtitle: Text(Tx(text: "Gain {card_name}", placeholders: {"card_name": Opaque})),
      ),
      ability: StrongCard(selection_policy: CardFitQuality, granted_copies: 1),
      weight: 8,
    ),

    AuguryArchetypeDefinition(
      id: "beecc1d9-9546-4ca2-858c-214527c7e530",
      name: "Grant: Category draft",
      presentation: (
        headline: Text(Tx("Choose a Card")),
        subtitle: Category(
          character: Tx("Choose a Character card to add to your deck."),
          event: Tx("Choose an Event Card to add to your deck."),
          cheap: Tx("Choose a cheap card to add to your deck."),
          mid_cost: Tx("Choose a mid-cost card to add to your deck."),
          expensive: Tx("Choose an expensive card to add to your deck."),
          fast: Tx("Choose a fast card to add to your deck."),
          subtype: Tx(
            text: "Choose one {subtype_name} card to add to your deck.",
            description: "[augury] Offer detail directing the player to choose a card from one card subtype. subtype_name is the independently localized canonical subtype title, such as Spirit Animal. Translators may reposition the placeholder or restructure the sentence so the title remains grammatically independent.",
            placeholders: {"subtype_name": Opaque},
          ),
          package: Tx(
            text: "Choose one card from the {package_reference} to add to your deck.",
            description: "[augury] Offer detail directing the player to choose a card from one authored tide package. package_reference is an independently localized grammatical reference authored for this sentence, such as Returning Legion package. Translators may reposition the placeholder or restructure the sentence.",
            placeholders: {"package_reference": Opaque},
          ),
        ),
      ),
      ability: CategoryDraftKnown(selection_policy: CardFit, chooser_size: 4, granted_copies: 1),
      weight: 10,
    ),

    AuguryArchetypeDefinition(
      id: "dfd3976a-b1dc-44fe-9aab-c13bd2c195e4",
      name: "Grant: Card bundle",
      presentation: (
        headline: Count(
          one: Tx(text: "Gain {count} Card", placeholders: {"count": Scalar}),
          other: Tx(text: "Gain {count} Cards", placeholders: {"count": Scalar}),
        ),
        subtitle: Count(
          one: Tx(text: "Add {count} Card to your deck.", placeholders: {"count": Scalar}),
          other: Tx(text: "Add {count} Cards to your deck.", placeholders: {"count": Scalar}),
        ),
      ),
      ability: CardBundle(bundle_size: 3, minimum_bundle_size: 2),
      weight: 8,
    ),

    AuguryArchetypeDefinition(
      id: "a5ac636d-9269-4379-9c61-567583fe9926",
      name: "Grant: Transfigured draft",
      presentation: (
        headline: Text(Tx("Choose a Transfigured Card")),
        subtitle: Text(Tx("Choose a transfigured card to add to your deck.")),
      ),
      ability: TransfiguredDraft(selection_policy: CardFit, chooser_size: 4, granted_copies: 1),
      weight: 6,
    ),

    AuguryArchetypeDefinition(
      id: "ec872e81-b7b4-4d81-9c69-1ca5317f6144",
      name: "Improve: Transfigure",
      presentation: (
        headline: Text(Tx("Transfigure a Card")),
        subtitle: Text(Tx(text: "Transfigure {card_name}", placeholders: {"card_name": Opaque})),
      ),
      ability: Transfigure(selection_policy: TransfigurationValue),
      weight: 10,
    ),

    AuguryArchetypeDefinition(
      id: "65a59007-6618-4f82-82ae-7da3bc6a205a",
      name: "Improve: Starter transfigure",
      presentation: (
        headline: Text(Tx("Transfigure Your Starters")),
        subtitle: Count(
          one: Tx(text: "Transfigure {card_name}", placeholders: {"card_name": Opaque}),
          other: Tx(
            text: "Transfigure {first_card_name} and {second_card_name}",
            placeholders: {"first_card_name": Opaque, "second_card_name": Opaque},
          ),
        ),
      ),
      ability: StarterTransfigure(selection_policy: TransfigurationValue, maximum_targets: 2),
      weight: 6,
    ),

    AuguryArchetypeDefinition(
      id: "df34c427-5e27-42d1-b903-c1d6d6dddd78",
      name: "Remove: Purge",
      presentation: (
        headline: Text(Tx("Purge a Card")),
        subtitle: Text(Tx(text: "Purge {card_name}", placeholders: {"card_name": Opaque})),
      ),
      ability: Purge(selection_policy: PurgeMisfit),
      weight: 8,
    ),

    AuguryArchetypeDefinition(
      id: "521bd487-0b3e-429e-a2f6-56010dd029c4",
      name: "Duplicate: Duplicate card",
      presentation: (
        headline: Count(one: Tx("Duplicate a Card"), other: Tx("Choose a Card")),
        subtitle: Count(
          one: Tx(text: "Duplicate {card_name}", placeholders: {"card_name": Opaque}),
          other: Tx(
            text: "Choose one of {count} cards in your deck to duplicate.",
            placeholders: {"count": Scalar},
          ),
        ),
      ),
      ability: Duplicate(selection_policy: DuplicateValue, chooser_size: 3, granted_copies: 1),
      weight: 8,
    ),

    AuguryArchetypeDefinition(
      id: "432102c0-91c0-4954-acd0-3404d2148a25",
      name: "Dreamsign: Grant dreamsign",
      presentation: (
        headline: Text(Tx("Gain a Dreamsign")),
        subtitle: Text(Tx(text: "Gain {dreamsign_name}", placeholders: {"dreamsign_name": Opaque})),
        background_art: CardImage(386654065),
      ),
      ability: Dreamsign(selection_policy: DreamsignMatch),
      weight: 8,
    ),

    AuguryArchetypeDefinition(
      id: "1003a54d-1659-490b-aa48-b88b9da5df68",
      name: "Site: Add a site",
      presentation: (
        headline: Text(Tx("Add a Site")),
        subtitle: Text(Tx(text: "Add the {site_name} site.", placeholders: {"site_name": Opaque})),
        background_art: CardImage(334049261),
      ),
      ability: AddSite,
      weight: 6,
    ),
  ],
)
