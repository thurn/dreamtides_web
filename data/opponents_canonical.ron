// Battle setup, Dreamwell construction, opponent progression and deck generation, and AI tuning.

#![enable(implicit_some)]
OpponentsCatalog(
  battle: BattleRules(
    minimum_deck_size: 25,
    player_opening_hand_size: 5,
    enemy_opening_hand_size: 5,
    score_targets: [10, 25],
    turn_limit: 50,
    energy_cap: 10,
    hand_limit: 10,
    starting_side: Player,
    skip_player_opening_draw: true,
    opponent_signature_card_count: 3,
  ),

  dreamwell: DreamwellRules(
    // Orders drawn once when constructing the initial Dreamwell.
    opening_orders: [0],
    // Orders eligible for every later Dreamwell refill.
    recurring_orders: [1, 2, 3, 4],
    cards_per_recurring_order: 5,
    minimum_constructed_length: 62,
  ),

  progression: ProgressionRules(
    // Layer values are zero-indexed completion levels.
    ability_active_from_layer: 1,
    dreamsigns_from_layer: 3,
    legendaries_from_layer: 5,
    // Later layers beyond this list contribute no starter cards.
    starter_dilution: [10, 5],
  ),

  coherent_draft: CoherentDraftRules(
    distinct_card_curve: CountCurve(first: 14, last: 30),
    removal_curve: CountCurve(first: 2, last: 8),
    temperature_curve: TemperatureCurve(first: 0.45, last: 0.12),
    best_of: 4,
    affiliation_objective_weight: 1.0,
    pack_source_records: 48,
    coherence: CoherenceRules(
      nearest_neighbors: 10,
      neighbor_weight: 0.5,
      cooccurrence_weight: 0.3,
      self_consistency_weight: 0.2,
      self_distractors: 12,
      self_recall_k: 4,
    ),
  ),

  corpus_selection: CorpusSelectionRules(affiliation_weight: 0.25, top_ranked_sampling_window: 8),

  journey_ai_deck: [
    DeckEntry(card_id: "5a980eff-6ec7-44d8-9977-b98e66bbc2c8", count: 3),

    DeckEntry(card_id: "647f5150-b2e0-424b-9480-27557642524e", count: 3),

    DeckEntry(card_id: "e83014d3-9d35-4e80-a1b3-9b25360ad2af", count: 3),

    DeckEntry(card_id: "a28ad36d-fa74-4190-a463-7efd3a6233d0", count: 3),

    DeckEntry(card_id: "a526fa7b-5cef-4da9-a3f2-27ee0bd9b481", count: 3),

    DeckEntry(card_id: "5ab11bef-5dcd-49f5-be49-ae2ccde76e70", count: 3),

    DeckEntry(card_id: "4408b942-09a0-4f4e-a403-10c708c6e3c5", count: 3),

    DeckEntry(card_id: "2162742c-09d0-4e62-ae49-0f8f79b45adc", count: 3),

    DeckEntry(card_id: "910b4cf9-dec7-4e03-af4f-7d5ae342eeba", count: 3),

    DeckEntry(card_id: "944e15d2-d680-4ebe-8d18-36826f4b1535", count: 3),
  ],

  ai: AiRules(
    journey_default_preset: Standard,
    tutorial_default_preset: Standard,
    evaluation: EvaluationWeights(
      score_difference: 10.0,
      front_rank_spark: 1.0,
      back_rank_spark: 0.5,
      hand_card: 1.5,
      value_hint: 1.0,
      energy_waste: 0.25,
      expected_points: 1.0,
    ),
    opponent_model: OpponentModelRules(
      removal_prior: 0.1,
      sample_safety_cap: 16,
      response_archetype_priors: ResponseArchetypePriors(
        no_blocks: 1.0,
        block_biggest: 2.0,
        trade_evenly: 3.0,
      ),
    ),
    presets: {
      Standard: AiPreset(
        beam_width: 12,
        opponent_mode: Expectiminimax,
        sample_count: 8,
        search_depth: 16,
        // Journey planning stops when this wall-clock budget is exhausted.
        journey_planning_budget_ms: 100,
        // Tutorial planning uses a deterministic expansion count for synchronized clients.
        tutorial_expansion_budget: 256,
      ),
    },
  ),
)
