  GlossaryDefinition(
    id: "23526f6e-f17e-4496-bf96-1875858d023d",
    category: Keywords,
    term: Tx("Erode"),
    definition: Tx(
      "Put cards from the top of a player’s deck into their void. For each card they can’t, their opponent scores 3⍟."
    ),
    priority: 95,
    matches_term_in_rules_text: true,
    variants: ["eroded", "erodes"],
    projections: [
      GlossaryProjection(
        pattern: r"\berode\s+(1)\b",
        term: Tx(text: "{term} {amount}", placeholders: {"term": Opaque, "amount": Scalar}),
        definition: Tx(
          "Put the top card of a player's deck into their void. If the deck is empty, their opponent scores 3⍟ instead."
        ),
      ),

      GlossaryProjection(
        pattern: r"\berode\s+(\d+)\b",
        term: Tx(text: "{term} {amount}", placeholders: {"term": Opaque, "amount": Scalar}),
        definition: Tx(
          text: "Put the top {amount} cards of a player's deck into their void. If the deck is empty, their opponent scores 3⍟ instead.",
