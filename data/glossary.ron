// Explanatory terms and projected definitions used by Dreamtides rules and journey surfaces.

#![enable(implicit_some)]
[
  GlossaryDefinition(
    id: "7ece2571-4681-4be3-aad6-76503bd77523",
    category: CardTypes,
    term: "Figment",
    definition: "A created token character. Multiple figments of the same type can be merged into one character.",
    // Higher values place this entry earlier when one rules source reveals several definitions.
    priority: 60,
    // Include the canonical term in rules-text recognition.
    matches_term_in_rules_text: true,
    // Additional word or symbol forms recognized as this term.
    variants: ["figments"],
  ),

  GlossaryDefinition(
    id: "a70ebef7-797a-491b-a888-382a0d7a7656",
    category: TriggersAndTiming,
    term: "▸Materialized",
    definition: "Triggers when this character enters play.",
    priority: 5,
    matches_term_in_rules_text: true,
  ),

  GlossaryDefinition(
    id: "c8a29383-b5bd-4971-98e7-e89e9edae648",
    category: TriggersAndTiming,
    term: "▸Dawn",
    definition: "Triggers at the start of controller's turn.",
    priority: 40,
    matches_term_in_rules_text: true,
    variants: ["dawn"],
  ),

  GlossaryDefinition(
    id: "3411c9fa-6606-4d69-ba30-d52637957cf7",
    category: TriggersAndTiming,
    term: "▸Challenge",
    definition: "Triggers when this character is declared as a challenger.",
    priority: 40,
    matches_term_in_rules_text: true,
  ),

  GlossaryDefinition(
    id: "12789839-a665-4195-925a-3229b857cf48",
    category: TriggersAndTiming,
    term: "▸Night",
    definition: "Triggers at the end of your turn.",
    priority: 40,
    matches_term_in_rules_text: true,
  ),

  GlossaryDefinition(
    id: "9183292b-112f-43c7-88ac-a41c4dd358c3",
    category: TriggersAndTiming,
    term: "Day",
    definition: "The turn phase when the active player plays standard cards.",
    priority: 10,
    matches_term_in_rules_text: true,
  ),

  GlossaryDefinition(
    id: "cf383187-e594-41ee-98c5-039a9402b2f8",
    category: TriggersAndTiming,
    term: "Rematerialize",
    definition: "Trigger an in-play character's materialization again.",
    priority: 75,
    matches_term_in_rules_text: true,
  ),

  GlossaryDefinition(
    id: "abef45fb-8c3f-4d63-9408-0eed1b7283bb",
    category: TriggersAndTiming,
    term: "▸Dissolved",
    definition: "Triggers when this character is sent to the void from play.",
    priority: 40,
    matches_term_in_rules_text: true,
  ),

  GlossaryDefinition(
    id: "3b83d2c9-5fc4-4d75-8b61-3518eebdc39e",
    category: TriggersAndTiming,
    term: "Dissolve",
    definition: "Destroy a character, sending it to the void.",
    priority: 60,
    matches_term_in_rules_text: true,
    variants: ["dissolves", "dissolved"],
  ),

  GlossaryDefinition(
    id: "f7b481e7-5130-45fe-9a34-a9b54a620d44",
    category: TriggersAndTiming,
    term: "Banish",
    definition: "Remove a card from the game.",
    priority: 60,
    matches_term_in_rules_text: true,
    variants: ["banished", "banishes"],
  ),

  GlossaryDefinition(
    id: "6efaf17e-7838-484e-9f29-cf7c249c9b5e",
    category: TriggersAndTiming,
    term: "Abandon",
    definition: "Dissolve a character you control.",
    priority: 75,
    matches_term_in_rules_text: true,
    variants: ["abandoned", "abandons"],
  ),

  GlossaryDefinition(
    id: "f7e1f058-74fe-46db-bb12-f5f887e6a298",
    category: Resources,
    term: "Points",
    definition: "Scoring points (⍟) allows you to win a dream battle. Each battle has a different target points threshold to win.",
    priority: 60,
    variants: ["⍟"],
    rules_symbol: RulesSymbol(token: points, glyph: Points, accessible_label: "points"),
    // Definition-only entries omit their term heading from combined definition surfaces.
    term_presentation: DefinitionOnly,
  ),

  GlossaryDefinition(
    id: "0dd0f69f-3879-40dd-82b8-6be0274f763d",
    category: Resources,
    term: "Memory",
    definition: "Memory Counters (⧗) are stored by cards to use later for effects.",
    priority: 60,
    variants: ["⧗"],
    rules_symbol: RulesSymbol(token: store, glyph: Memory, accessible_label: "memory"),
    term_presentation: DefinitionOnly,
  ),

  GlossaryDefinition(
    id: "374c29e9-deb1-4e3d-8410-b81bacc8588b",
    category: Keywords,
    term: "Reclaim",
    definition: "You may play this card from your void, then banish it when it leaves play.",
    priority: 100,
    matches_term_in_rules_text: true,
    variants: ["reclaimed"],
    // The first matching projection overrides the displayed term or definition.
    projections: [
      GlossaryProjection(
        // Case-insensitive Unicode regular expression evaluated against the complete source text.
        pattern: r"\b(?:gain|gains|gained)\s+reclaim\s+(\d+)\s*●",
        // Templates may expand {term} and numbered regular-expression captures.
        term: "{term} {1}●",
        definition: "You may play that card from your void for {1}●, then banish it when it leaves play.",
      ),

      GlossaryProjection(
        pattern: r"\breclaim\s+(\d+)\s*●",
        term: "{term} {1}●",
        definition: "You may play this card from your void for {1}●, then banish it when it leaves play.",
      ),

      GlossaryProjection(
        pattern: r"\b(?:gain|gains|gained)\s+reclaim\b",
        definition: "You may play that card from your void, then banish it when it leaves play.",
      ),
    ],
  ),

  GlossaryDefinition(
    id: "21e9a392-3983-49ba-8072-aa950c63ebad",
    category: Keywords,
    term: "Foresee",
    definition: "Look at the top N cards of your deck, put any number into your void, and put the rest back on top in any order.",
    priority: 95,
    matches_term_in_rules_text: true,
    projections: [
      GlossaryProjection(
        pattern: r"\bforesee\s+(1)\b",
        term: "{term} {1}",
        definition: "Look at the top card of your deck. You may put it into your void.",
      ),

      GlossaryProjection(
        pattern: r"\bforesee\s+(\d+)\b",
        term: "{term} {1}",
        definition: "Look at the top {1} cards of your deck, then put any number of them into your void and the rest on top in any order.",
      ),
    ],
  ),

  GlossaryDefinition(
    id: "5bda4696-32f9-4df2-a784-80120d76578b",
    category: Keywords,
    term: "Discover",
    definition: "Reveal three matching cards from your deck and choose one to draw.",
    priority: 95,
    matches_term_in_rules_text: true,
  ),

  GlossaryDefinition(
    id: "23526f6e-f17e-4496-bf96-1875858d023d",
    category: Keywords,
    term: "Erode",
    definition: "Put cards from the top of a player’s deck into their void. For each card they can’t, their opponent scores 3⍟.",
    priority: 95,
    matches_term_in_rules_text: true,
    variants: ["eroded", "erodes"],
    projections: [
      GlossaryProjection(
        pattern: r"\berode\s+(1)\b",
        term: "{term} {1}",
        definition: "Put the top card of a player's deck into their void. If the deck is empty, their opponent scores 3⍟ instead.",
      ),

      GlossaryProjection(
        pattern: r"\berode\s+(\d+)\b",
        term: "{term} {1}",
        definition: "Put the top {1} cards of a player's deck into their void. If the deck is empty, their opponent scores 3⍟ instead.",
      ),
    ],
  ),

  GlossaryDefinition(
    id: "63a9d425-f7f2-4acf-a7ff-57fd58ad34fc",
    category: Keywords,
    term: "Fast",
    definition: "A fast (❖) card may be played at the end of either player's turn.",
    priority: 95,
    variants: ["❖"],
    term_presentation: DefinitionOnly,
    projections: [
      GlossaryProjection(
        pattern: r"(?:^|\n)\s*❖\s*[–-]",
        definition: "A fast (❖) ability may be activated at the end of either player's turn.",
      ),
    ],
  ),

  GlossaryDefinition(
    id: "c7ec2870-5c8b-43ad-bcb0-d603bba12dea",
    category: Keywords,
    term: "Interrupt",
    definition: "An interrupt (❖❖) card may be played in response to an opponent action, or at the end of either player's turn.",
    priority: 95,
    variants: ["❖❖"],
    term_presentation: DefinitionOnly,
    projections: [
      GlossaryProjection(
        pattern: r"(?:^|\n)\s*❖❖\s*[–-]",
        definition: "An interrupt (❖❖) ability may be activated in response to an opponent action, or at the end of either player's turn.",
      ),
    ],
  ),

  GlossaryDefinition(
    id: "a5fe9cb8-1162-44f3-9634-99839eecbb1a",
    category: Keywords,
    term: "Exhaust Cost",
    definition: "A back-rank character may exhaust (☾) once per turn to use an ability instead of challenging.",
    priority: 95,
    variants: ["☾"],
    rules_symbol: RulesSymbol(token: lunar, glyph: Exhaust, accessible_label: "lunar"),
    term_presentation: DefinitionOnly,
    projections: [
      GlossaryProjection(
        // Limit this projection to rules text owned by the selected entity type.
        owner: DreamAvatar,
        definition: "You may exhaust (☾) this avatar to activate this ability once per turn.",
      ),
    ],
  ),

  GlossaryDefinition(
    id: "75aae855-4ddc-41f3-9732-dd5922b897b8",
    category: Keywords,
    term: "Awakened",
    definition: "Can challenge and activate ☾ abilities on the same turn in which it is materialized.",
    priority: 90,
    matches_term_in_rules_text: true,
    variants: ["awaken", "awakens"],
  ),

  GlossaryDefinition(
    id: "10e82210-de89-4266-8f98-d9764ab3807e",
    category: BattleStatus,
    term: "Exhausted",
    definition: "This character cannot challenge or use ☾ abilities until next turn.",
    priority: 30,
    matches_term_in_rules_text: true,
    // Optional glyph shown beside the entry in combined definition surfaces.
    definition_symbol: Exhaust,
