  GlossaryDefinition(
    id: "374c29e9-deb1-4e3d-8410-b81bacc8588b",
    category: Keywords,
    term: Tx("Reclaim"),
    definition: Tx("You may play this card from your void, then banish it when it leaves play."),
    priority: 100,
    matches_term_in_rules_text: true,
    variants: ["reclaimed"],
    // The first matching projection overrides the displayed term or definition.
    projections: [
      GlossaryProjection(
        // Case-insensitive Unicode regular expression evaluated against the complete source text.
        pattern: r"\b(?:gain|gains|gained)\s+reclaim\s+(\d+)\s*●",
        // Templates may expand {term} and numbered regular-expression captures.
        term: Tx(text: "{term} {amount}●", placeholders: {"term": Opaque, "amount": Scalar}),
        definition: Tx(
          text: "You may play that card from your void for {amount}●, then banish it when it leaves play.",
          placeholders: {"amount": Scalar},
        ),
      ),

      GlossaryProjection(
        pattern: r"\breclaim\s+(\d+)\s*●",
        term: Tx(text: "{term} {amount}●", placeholders: {"term": Opaque, "amount": Scalar}),
        definition: Tx(
          text: "You may play this card from your void for {amount}●, then banish it when it leaves play.",
          placeholders: {"amount": Scalar},
        ),
      ),

      GlossaryProjection(
        pattern: r"\b(?:gain|gains|gained)\s+reclaim\b",
        definition: Tx(
          "You may play that card from your void, then banish it when it leaves play."
        ),
      ),
    ],
  ),

  GlossaryDefinition(
    id: "21e9a392-3983-49ba-8072-aa950c63ebad",
    category: Keywords,
    term: Tx("Foresee"),
    definition: Tx(
      "Look at the top N cards of your deck, put any number into your void, and put the rest back on top in any order."
    ),
    priority: 95,
    matches_term_in_rules_text: true,
    projections: [
      GlossaryProjection(
        pattern: r"\bforesee\s+(1)\b",
        term: Tx(text: "{term} {amount}", placeholders: {"term": Opaque, "amount": Scalar}),
        definition: Tx("Look at the top card of your deck. You may put it into your void."),
      ),

      GlossaryProjection(
        pattern: r"\bforesee\s+(\d+)\b",
        term: Tx(text: "{term} {amount}", placeholders: {"term": Opaque, "amount": Scalar}),
        definition: Tx(
          text: "Look at the top {amount} cards of your deck, then put any number of them into your void and the rest on top in any order.",
          placeholders: {"amount": Scalar},
        ),
      ),
    ],
