// Controls the seven-layer Dream Atlas: its topology, site composition,
// dreamscape selection, boss presentation, and authored asset references.

#![enable(implicit_some)]
AtlasCatalog(
  layers: [
    LayerDefinition(position: One, rules: Starter),
    LayerDefinition(
      position: Two,
      rules: Standard(
        node_count: (min: 2, max: 2),
        site_count: (min: 3, max: 6),
        fill_profile: Early,
        mandatory_sites: {Draft: 2, Purge: 1, Augury: 1},
      ),
    ),
    LayerDefinition(
      position: Three,
      rules: Standard(
        node_count: (min: 3, max: 3),
        site_count: (min: 3, max: 6),
        fill_profile: Early,
        mandatory_sites: {Draft: 1, Purge: 1},
      ),
    ),
    LayerDefinition(
      position: Four,
      rules: Standard(
        node_count: (min: 3, max: 4),
        site_count: (min: 3, max: 6),
        fill_profile: Early,
        mandatory_sites: {Draft: 1},
      ),
    ),
    LayerDefinition(
      position: Five,
      rules: Standard(node_count: (min: 3, max: 5), site_count: (min: 3, max: 6), fill_profile: Late),
    ),
    LayerDefinition(
      position: Six,
      rules: Standard(node_count: (min: 3, max: 5), site_count: (min: 3, max: 6), fill_profile: Late),
    ),
    LayerDefinition(position: Seven, rules: Boss(site_count: (min: 3, max: 6), fill_profile: Late)),
  ],

  graph: (
    connection_average: 2.0,
    reveal_lookahead_layers: 2,
    bonus_reveal: (count: (min: 0, max: 2), mode: 1, eligible_layers: [Five, Six]),
  ),

  dreamscape_selection: (
    base_weight: 1.0,
    repeat_discourage_strength: 2.0,
    exclude_connected_repeats: true,
    exclude_same_layer_repeats: true,
    exhaustion_fallback: AllowRepeats,
  ),

  site_composition: (unique_non_draft_sites: true, known_dreamsign_site: Reward, mandatory_capacity_behavior: OmitFill),

  fill_profiles: {
    Early: FillProfile(
      signature_site_weight: 3.0,
      site_weights: {Essence: 3.0, Transfiguration: 1.0, Duplication: 1.0},
    ),
    Late: FillProfile(signature_site_weight: 3.0, site_weights: {Essence: 3.0, Transfiguration: 5.0, Duplication: 5.0}),
  },

  known_dreamsign: (
    max_per_atlas: 2,
    eligible_layers: [Three, Four, Five, Six],
    placement_probability: 0.5,
    early_reveal_bias: 1.0,
  ),

  boss: (
    dreamscape_id: "f31e1199-70bc-4110-85f9-505afebb02c4",
    place: "Limbo",
    name: "Apollyon",
    fallback_title: "Apollyon, the Doom of Humanity",
    fallback_introduction: "An avatar of annihilating power — his own deck, dreamsigns, and abilities bend the dream toward ruin.",
    art: (
      scene: (key: "limbo", source: "limbo.png"),
      icon: (key: "limbo", source: "limbo_icon.png"),
      figure: (key: "apollyon", source: "apollyon.png"),
    ),
  ),

  presentation: (
    unrevealed: (
      title: "An Unseen Dream",
      body: "This dreamscape is revealed only as you draw near. Travel onward to learn what waits here.",
      frame: (key: "Round_frame_main.png", source: "Round_frame_main.png"),
    ),
    starter_body: "A quiet place where every dream journey begins.",
    affiliation: (title_template: "Affiliation: {name}", body_template: "{card-theme} cards are more likely here."),
  ),
)
