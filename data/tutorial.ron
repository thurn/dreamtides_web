// Complete scripted tutorial, battle setup, journey guidance, and supplemental teaching triggers.

#![enable(implicit_some)]
TutorialCatalog(
  // Default desktop width for any tutorial bubble or trigger without an override.
  default_maximum_width_pixels: 500,

  // Ordered, event-log-backed sequence played before the live tutorial battle begins.
  scripted_tutorial_sequence: [
    TutorialActionDefinition(
      id: "3f7f1086-8a50-4bc9-a7d2-6bf68fde992f",
      // Seconds to wait before the sequence advances from this action.
      wait_seconds: 0,
      behavior: DisplaySpeechBubble(
        speech_bubble: TutorialSpeechBubble(
          duration_seconds: 3,
          maximum_width_pixels: 700,
          text: Tx("Welcome, Dreamer."),
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "c06dbc13-a48c-499e-83b3-b24e555ed008",
      wait_seconds: 0,
      behavior: AnimateDreamAvatarPortrait(owner: Player, pause_seconds: 1, duration_seconds: 0.6),
    ),

    TutorialActionDefinition(
      id: "8bae0625-6f94-472b-8752-1719166d0fb4",
      wait_seconds: 0,
      behavior: DisplaySpeechBubble(
        speech_bubble: TutorialSpeechBubble(
          duration_seconds: 3,
          vertical_offset_pixels: 100,
          maximum_width_pixels: 700,
          text: Tx("You are called to stand against\nthe power of Nightmare."),
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "548ef8f2-44d2-4af8-ae92-b13f089a42e1",
      wait_seconds: 0,
      behavior: AnimateDreamAvatarPortrait(owner: Enemy, pause_seconds: 1, duration_seconds: 0.6),
    ),

    TutorialActionDefinition(
      id: "54325d07-bf55-4709-bb4a-fbfe098c81f5",
      wait_seconds: 0,
      behavior: DisplaySpeechBubble(
        speech_bubble: TutorialSpeechBubble(
          speaker: Enemy,
          duration_seconds: 3,
          maximum_width_pixels: 300,
          text: Tx("For the Abyss!"),
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "f94ec9e9-c558-45b8-a6ba-69a8d9bb3c71",
      wait_seconds: 0,
      behavior: DrawOpponentCard(card_id: "229ab3a1-3720-41a2-924c-8fe112188f8e"),
    ),

    TutorialActionDefinition(
      id: "d641f65f-8d2d-4d3c-a572-b12dbf5d1490",
      wait_seconds: 0,
      behavior: RevealAndPlayOpponentCard(
        card_id: "229ab3a1-3720-41a2-924c-8fe112188f8e",
        reveal_duration_seconds: 2,
      ),
    ),

    TutorialActionDefinition(
      id: "08519d56-96a5-49f9-a508-4a604fe11fe0",
      wait_seconds: 0,
      behavior: DisplayHowToPlay(
        trigger: PlayerTurnAnnouncementComplete,
        text: Tx(
          "You can [yellow]materialize[/yellow] characters and then [yellow]challenge[/yellow] with them to score points (⍟) equal to their spark (✦).\n\nScore 10⍟ to win this dream battle."
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "0afd72f6-ec5f-4ebb-a5c7-5975af025576",
      wait_seconds: 0,
      behavior: EndTurn(),
    ),

    TutorialActionDefinition(
      id: "35292d09-7eac-4f14-8777-48787d217405",
      wait_seconds: 0,
      behavior: DrawDreamwellCard(owner: Enemy, card_id: "02e8ea92-1218-413c-9f0b-4c865a3921d3"),
    ),

    TutorialActionDefinition(
      id: "597d8b4e-a424-4ea7-8919-a8194b82fcaa",
      wait_seconds: 0,
      behavior: DisplayHowToPlay(
        trigger: Immediate,
        companion: DreamwellCard,
        card_width_pixels: 500,
        text: Tx(
          "From turn 2, players draw [yellow]dreamwell[/yellow] cards that increase their energy (●) production and have special effects."
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "64f80a9f-9eaa-4247-ab2c-2bc278c292d0",
      wait_seconds: 0,
      behavior: DrawOpponentCard(card_id: "a28ad36d-fa74-4190-a463-7efd3a6233d0"),
    ),

    TutorialActionDefinition(
      id: "fbf90344-247a-4d8f-81cd-9324c3761fcd",
      wait_seconds: 0,
      behavior: RevealAndPlayOpponentCard(
        card_id: "a28ad36d-fa74-4190-a463-7efd3a6233d0",
        reveal_duration_seconds: 5,
        speech_bubble: TutorialSpeechBubble(
          duration_seconds: 4,
          text: Tx("This card has a ▸Dawn ability which triggers at the start of turn."),
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "c2953e09-b017-486f-a315-a8fce33c38f3",
      wait_seconds: 0,
      behavior: DisplaySpeechBubble(
        speech_bubble: TutorialSpeechBubble(
          speaker: Enemy,
          duration_seconds: 3,
          maximum_width_pixels: 300,
          text: Tx("My character [yellow]challenges[/yellow] you! Prove your worth!"),
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "42bf48ce-4fa8-48ed-8458-dfd83df03679",
      wait_seconds: 1.5,
      behavior: RepositionOpponentCharacter(card_id: "229ab3a1-3720-41a2-924c-8fe112188f8e"),
    ),

    TutorialActionDefinition(
      id: "eca0ebe7-208a-4c7b-9153-d051418b29d6",
      wait_seconds: 0,
      behavior: DisplayHowToPlay(
        trigger: Immediate,
        text: Tx(
          "Characters in the front rank [yellow]challenge[/yellow] during their turn and [yellow]block[/yellow] challengers during the opponent's turn."
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "876b59d1-cc76-4086-bdaf-3fb106c283c5",
      wait_seconds: 0,
      behavior: RepositionPlayerCharacter(
        card_id: "e83014d3-9d35-4e80-a1b3-9b25360ad2af",
        opposing_card_id: "229ab3a1-3720-41a2-924c-8fe112188f8e",
      ),
    ),

    TutorialActionDefinition(
      id: "c9ead9e0-bef7-41e2-aef6-206be4b9971e",
      wait_seconds: 1,
      behavior: ResolveChallenge(
        challenger_card_id: "229ab3a1-3720-41a2-924c-8fe112188f8e",
        blocker_card_id: "e83014d3-9d35-4e80-a1b3-9b25360ad2af",
      ),
    ),

    TutorialActionDefinition(
      id: "01109c14-02cb-449c-86e0-0915d6119c10",
      wait_seconds: 0,
      behavior: DisplaySpeechBubble(
        speech_bubble: TutorialSpeechBubble(
          duration_seconds: 10,
          vertical_offset_pixels: -30,
          text: Tx(
            "The lowest spark (✦) character in the challenge is [yellow]dissolved[/yellow] and sent to the void."
          ),
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "37a8690c-08f8-4aac-8285-f3e7c6c66740",
      wait_seconds: 0,
      behavior: DisplaySpeechBubble(
        speech_bubble: TutorialSpeechBubble(
          duration_seconds: 10,
          vertical_offset_pixels: 30,
          text: Tx(
            "A [yellow]blocked[/yellow] character that isn't dissolved scores fewer points (⍟), reduced by the enemy's spark (✦)."
          ),
        ),
      ),
    ),

    TutorialActionDefinition(
      id: "a5abd23e-f92e-4dd7-80bb-fcb760eacba5",
      wait_seconds: 0,
      behavior: DrawDreamwellCard(
        owner: Player,
        card_id: "7171ff89-ebe4-42d0-8863-9b4b0531cad2",
        reveal_duration_seconds: 3,
      ),
    ),

    TutorialActionDefinition(
      id: "d36e30f6-59e6-46a7-a214-3cfa3668d5e0",
      wait_seconds: 0,
      behavior: DrawCard(
        owner: Player,
        card_id: "5a980eff-6ec7-44d8-9977-b98e66bbc2c8",
        reason: DreamwellEffect,
      ),
    ),

    TutorialActionDefinition(
      id: "04d04c5e-89d8-4544-a806-1231895000b8",
      wait_seconds: 0,
      behavior: DrawCard(
        owner: Player,
        card_id: "a526fa7b-5cef-4da9-a3f2-27ee0bd9b481",
        reason: DreamwellEffect,
      ),
    ),

    TutorialActionDefinition(
      id: "8dd10d24-4723-4630-919c-c4a6c97d50fc",
      wait_seconds: 0,
      behavior: DrawCard(
        owner: Enemy,
        card_id: "229ab3a1-3720-41a2-924c-8fe112188f8e",
        reason: DreamwellEffect,
      ),
    ),

    TutorialActionDefinition(
      id: "4773ed9a-44d3-41c7-970b-7a40766d7360",
      wait_seconds: 0,
      behavior: DrawCard(
        owner: Enemy,
        card_id: "4408b942-09a0-4f4e-a403-10c708c6e3c5",
        reason: DreamwellEffect,
      ),
    ),

    TutorialActionDefinition(
      id: "c41035f0-4bd1-4835-bc0e-25fc0d01fba4",
      wait_seconds: 0,
      behavior: DrawCard(
        owner: Player,
        card_id: "2162742c-09d0-4e62-ae49-0f8f79b45adc",
        reason: TurnDraw,
      ),
    ),

    TutorialActionDefinition(
      id: "b42ce692-bcc4-41a7-bc86-da62000ab350",
      wait_seconds: 0,
      behavior: DisplaySpeechBubble(
        speech_bubble: TutorialSpeechBubble(
          duration_seconds: 5,
          text: Tx(
            "An [purple]event[purple] card has a one-time effect, and then is sent the void."
          ),
        ),
      ),
    ),
  ],

  battle: TutorialBattleConfiguration(
    player_dream_avatar_id: "bfc40414-5264-41bf-86e1-a0f41ee4f5b5",
    enemy_dream_avatar_id: "b99936ca-97f9-4930-af5a-fa9ef92557ef",
    starting_energy: 4,
    score_to_win: 10,
    starter_deck: {
      "5a980eff-6ec7-44d8-9977-b98e66bbc2c8": 3,
      "647f5150-b2e0-424b-9480-27557642524e": 3,
      "e83014d3-9d35-4e80-a1b3-9b25360ad2af": 3,
      "a28ad36d-fa74-4190-a463-7efd3a6233d0": 3,
      "a526fa7b-5cef-4da9-a3f2-27ee0bd9b481": 3,
      "5ab11bef-5dcd-49f5-be49-ae2ccde76e70": 3,
      "4408b942-09a0-4f4e-a403-10c708c6e3c5": 3,
      "2162742c-09d0-4e62-ae49-0f8f79b45adc": 3,
      "910b4cf9-dec7-4e03-af4f-7d5ae342eeba": 3,
      "944e15d2-d680-4ebe-8d18-36826f4b1535": 3,
    },
    forced_player_draws: [
      "4408b942-09a0-4f4e-a403-10c708c6e3c5",
      "647f5150-b2e0-424b-9480-27557642524e",
      "5ab11bef-5dcd-49f5-be49-ae2ccde76e70",
      "944e15d2-d680-4ebe-8d18-36826f4b1535",
      "910b4cf9-dec7-4e03-af4f-7d5ae342eeba",
    ],
    forced_enemy_draws: [
      "944e15d2-d680-4ebe-8d18-36826f4b1535",
      "910b4cf9-dec7-4e03-af4f-7d5ae342eeba",
      "647f5150-b2e0-424b-9480-27557642524e",
      "5a980eff-6ec7-44d8-9977-b98e66bbc2c8",
      "5ab11bef-5dcd-49f5-be49-ae2ccde76e70",
    ],
    // Complete shared deck prefix, including the two pre-handoff scripted draws.
    dreamwell_draws: [
      "02e8ea92-1218-413c-9f0b-4c865a3921d3",
      "7171ff89-ebe4-42d0-8863-9b4b0531cad2",
      "51caf26d-83bf-45a9-bc80-010d353277db",
      "5ec17498-9028-4a01-80a0-67c91b03d505",
      "03e4e701-4720-4278-8198-9b7e0514d4cf",
      "de98477c-e216-4618-bff1-0e24bd982fdb",
      "662b7393-751c-4aa9-8150-5f20b4d176a4",
      "120ec4c2-aa7b-48f4-be9f-f39820e565ca",
      "eae99eb2-0fa8-4d12-b7b2-3f5387cb6d3a",
      "a57f1276-3fb6-4527-b538-953fbace35cf",
      "a9c254c4-8448-40ea-bb1a-08c0ef8c7bdf",
    ],
    // Constants for cards used by tutorial presentation, scripted actions, and the live battle
    // handoff.
    tutorial_card_constants: TutorialCardConstants(
      // Character controlled by the player throughout the scripted tutorial sequence.
      tutorial_player_character_card_id: "e83014d3-9d35-4e80-a1b3-9b25360ad2af",
      // Character controlled by the opponent throughout the scripted tutorial sequence.
      tutorial_opponent_character_card_id: "229ab3a1-3720-41a2-924c-8fe112188f8e",
      // Character shown beside the event card on the tutorial loading screen.
      loading_screen_character_card_id: "a526fa7b-5cef-4da9-a3f2-27ee0bd9b481",
      // Event shown beside the character card on the tutorial loading screen.
      loading_screen_event_card_id: "944e15d2-d680-4ebe-8d18-36826f4b1535",
      // Enemy character materialized into the back rank when the live battle begins.
      handoff_enemy_character_card_id: "a28ad36d-fa74-4190-a463-7efd3a6233d0",
      // Dreamwell card featured during the scripted tutorial sequence.
      tutorial_dreamwell_card_id: "02e8ea92-1218-413c-9f0b-4c865a3921d3",
    ),
    // Exact rules-engine state created when the scripted sequence hands control to the player.
    handoff: TutorialBattleHandoff(
      active_side: Player,
      turn_number: 4,
      phase: Dawn,
      dreamwell_deck_index: 2,
      player: TutorialHandoffSide(
        current_energy: 5,
        maximum_energy: 5,
        score: 0,
        dreamwell_card_index: 1,
        dreamwell_drawn_turn: 3,
      ),
      enemy: TutorialHandoffSide(
        current_energy: 0,
        maximum_energy: 5,
        score: 2,
        dreamwell_card_index: 0,
        dreamwell_drawn_turn: 2,
      ),
      // Card roles to materialize into the live board; Deck consumes a starter-deck copy and
      // Created mints one.
      card_placements: [
        Rank(card: TutorialPlayerCharacter, side: Player, source: Deck, slot: Front(4)),
        Rank(card: HandoffEnemyCharacter, side: Enemy, source: Deck, slot: Back(5)),
        Void(card: TutorialOpponentCharacter, side: Enemy, source: Created),
      ],
    ),
    ai_action_overrides: [
      // A one-shot authored AI decision. Matching proceeds in source order before heuristic
      // planning.
      TutorialAiActionOverride(
        // Stable identity used to consume this override exactly once in the shared room log.
        id: "2fd657e4-02d2-412e-acad-4b063504a188",
        // Battle-state edge which makes this override eligible.
        trigger: AfterEnemyDreamwell(card_id: "51caf26d-83bf-45a9-bc80-010d353277db"),
        // Semantic action submitted through the ordinary battle play-card path.
        action: PlayCard(card_id: "229ab3a1-3720-41a2-924c-8fe112188f8e"),
      ),
    ],
  ),

  journey_guidance: TutorialJourneyGuidance(
    journey_start: TutorialSpeechBubble(
      // Seconds after the owning tutorial surface becomes active before this guidance appears.
      delay_seconds: 1,
      // Pixels added to the computed horizontal dialogue position.
      horizontal_offset_pixels: 40,
      // Desktop maximum width of the speech bubble, in pixels.
      maximum_width_pixels: 550,
      text: Tx(
        "For each journey, you must choose a [purple]Dream Avatar[/purple] who provides a permanent ability."
      ),
    ),
    dreamscape: TutorialSpeechBubble(
      delay_seconds: 1,
      maximum_width_pixels: 700,
      text: Tx(
        "In each dream, you will visit [purple]sites[/purple] to build your deck and prepare for a [purple]dream battle[/purple]."
      ),
    ),
    atlas: TutorialSpeechBubble(
      delay_seconds: 1,
      maximum_width_pixels: 700,
      text: Tx("On the [purple]Atlas[/purple] screen, you will pick which dream to enter next."),
    ),
    draft: TutorialSpeechBubble(
      delay_seconds: 1,
      maximum_width_pixels: 600,
      text: Tx(
        "At a [purple]Draft[/purple] site you build your deck by repeatedly selecting one of four cards to add."
      ),
    ),
    purge: TutorialSpeechBubble(
      delay_seconds: 1,
      maximum_width_pixels: 600,
      text: Tx(
        "You can [yellow]purge[/yellow] cards here, removing them from your deck for an ◆ essence cost."
      ),
    ),
    dreamsign_revelation: TutorialSpeechBubble(
      delay_seconds: 1,
      maximum_width_pixels: 600,
      text: Tx(
        "A [purple]Dreamsign[/purple] is a persistent artifact of the dream that gives ongoing benefits."
      ),
    ),
    first_battle: TutorialSpeechBubble(
      delay_seconds: 1,
      maximum_width_pixels: 700,
      text: Tx(
        "Before each dream battle, you can view cards from your opponent's deck and see the ⍟ required to win"
      ),
    ),
    second_battle: TutorialSpeechBubble(
      delay_seconds: 1,
      maximum_width_pixels: 700,
      text: Tx(
        "For this battle, the opponent's avatar ability is active and you must score 25⍟ to win"
      ),
    ),
  ),

  // Shared first-occurrence explanations evaluated during the tutorial journey and battles.
  triggers: [
    TutorialTriggerDefinition(
      id: "9a5b5f0b-8e0b-437e-b04c-d12ab6e6071c",
      on: [OpponentRepositionOpportunity],
      priority: 10,
      duration_seconds: 5,
      matcher: Any,
      text: Tx(
        "During your [purple]Dusk[/purple] phase, the opposing player may reposition their characters."
      ),
    ),

    TutorialTriggerDefinition(
      id: "abe76c76-63ad-481e-9f22-559f33f845b8",
      on: [PlayerNightPhase],
      priority: 10,
      duration_seconds: 6,
      matcher: Any,
      text: Tx(
        "During your [purple]Night[/purple] phase, you can play ❖ fast cards and activate ❖ fast abilities"
      ),
    ),

    TutorialTriggerDefinition(
      id: "277d95c1-e7a7-4d5a-9ee7-a5d26869bf75",
      on: [CardNoValidTargets],
      priority: 10,
      duration_seconds: 4,
      matcher: Card(card_id: "4408b942-09a0-4f4e-a403-10c708c6e3c5"),
      text: Tx("There are no valid targets for this card"),
    ),

    TutorialTriggerDefinition(
      id: "a0d61b83-d347-41ab-87ac-34842b3562d6",
      on: [ChallengeResolved],
      priority: 10,
      duration_seconds: 5,
      matcher: Any,
      text: Tx(
        "If there is a tie in spark (✦) values, both characters in the challenge are dissolved"
      ),
    ),

    TutorialTriggerDefinition(
      id: "bdbcfb47-8a5d-4649-b2fd-1f1c4ca74fe5",
      on: [TransfigurationSeen],
      priority: 100,
      delay_seconds: {TransfigurationSeen: 1},
      duration_seconds: 5,
      matcher: Any,
      text: Tx(
        "Cards can be [yellow]transfigured[/yellow] to change their cost, spark, or abilities"
      ),
    ),

    TutorialTriggerDefinition(
      id: "8dccf13b-3883-4a30-acda-80743a9b6f94",
      on: [CardSeen, CardPlay, DreamwellResolve],
      priority: 100,
      delay_seconds: {CardSeen: 1},
      duration_seconds: 5,
      matcher: Glossary(glossary_id: "59f426ac-b9cb-47af-a00a-8cbab941c6c4"),
      text: Tx(
        "A character with [yellow]support[/yellow] gives a bonus to the two characters in front of it."
      ),
    ),

    TutorialTriggerDefinition(
      id: "1acc7803-e2a8-4628-a1b7-2b530d4faf89",
      on: [CardSeen, CardPlay, DreamwellResolve],
      priority: 100,
      delay_seconds: {CardSeen: 1},
      duration_seconds: 5,
      matcher: Glossary(glossary_id: "21e9a392-3983-49ba-8072-aa950c63ebad"),
      text: Tx(
        "To [yellow]foresee[/yellow] 1, look at the top card of your deck. You may put it into your void."
      ),
    ),

    TutorialTriggerDefinition(
      id: "d6867701-d59d-448e-9b3e-93851861c53b",
      on: [CardSeen, CardPlay],
      priority: 100,
      delay_seconds: {CardSeen: 1},
      duration_seconds: 3,
      matcher: Glossary(glossary_id: "abef45fb-8c3f-4d63-9408-0eed1b7283bb"),
      text: Tx("A ▸Dissolved ability triggers when the character is sent to the void."),
    ),

    TutorialTriggerDefinition(
      id: "85df10e7-cf05-4c7a-aa7a-cb29f9f072b8",
      on: [CardSeen, CardPlay, DreamwellResolve],
      priority: 100,
      delay_seconds: {CardSeen: 1},
      duration_seconds: 3,
      matcher: Glossary(glossary_id: "5bda4696-32f9-4df2-a784-80120d76578b"),
      text: Tx(
        "To [yellow]discover[/yellow] a card, reveal 3 matching cards from your deck and pick one to draw."
      ),
    ),

    TutorialTriggerDefinition(
      id: "93327f3c-8c77-4947-8fca-6b4f4e51e528",
      on: [CardSeen, CardPlay, DreamwellResolve],
      priority: 100,
      delay_seconds: {CardSeen: 1},
      duration_seconds: 10,
      matcher: Glossary(glossary_id: "23526f6e-f17e-4496-bf96-1875858d023d"),
      text: Tx("[yellow]Erode[/yellow] means to put cards from a deck into the void."),
    ),

    TutorialTriggerDefinition(
      id: "243537f6-acf7-4446-8599-87b1bb1789a5",
      on: [FigmentCreated],
      priority: 100,
      duration_seconds: 8,
      matcher: Any,
      text: Tx("Figments are token representations of characters which can be merged together."),
    ),

    TutorialTriggerDefinition(
      id: "57b57322-62e5-48db-9de9-e2bca9e5600d",
      on: [CardSeen, CardPlay, DreamwellResolve],
      priority: 100,
      delay_seconds: {CardSeen: 1},
      duration_seconds: 3,
      matcher: Glossary(glossary_id: "f7b481e7-5130-45fe-9a34-a9b54a620d44"),
      text: Tx(
        "To [yellow]banish[/yellow] a card, remove it from the game. It does not go to the void."
      ),
    ),

    TutorialTriggerDefinition(
      id: "2f67b4c7-9edd-49e9-8e26-c310eca409fe",
      on: [CardSeen, CardPlay, DreamwellResolve],
      priority: 100,
      delay_seconds: {CardSeen: 1},
      duration_seconds: 3,
      matcher: Glossary(glossary_id: "3b83d2c9-5fc4-4d75-8b61-3518eebdc39e"),
      text: Tx("To [yellow]dissolve[/yellow] a character, send it to its controller’s void."),
    ),

    TutorialTriggerDefinition(
      id: "5d43c5d4-c8e0-4492-9ae8-743e7f381161",
      on: [CardSeen, CardPlay, DreamwellResolve],
      priority: 100,
