// Defines shared journey currency costs, rewards, and shop inventories.

#![enable(implicit_some)]
EconomyCatalog(
  journey: (default_starting_essence: 200, dreamsign_cap: 12),

  shop: (
    prices: (standard_card: 100, specialty_card: 200, dreamsign: 50),
    stock: [
      ShopStock(shop: CardShop, card_slots: 5, dreamsign_slots: 0),

      ShopStock(shop: SpecialtyShop, card_slots: 5, dreamsign_slots: 0),

      ShopStock(shop: DreamsignMarket, card_slots: 0, dreamsign_slots: 3),
    ],
    discounts: (
      // Relative weights select how many generated offers receive a discount.
      slot_counts: [(value: 1, weight: 1), (value: 2, weight: 1)],
      percentages: [
        (value: 30, weight: 1),
        (value: 40, weight: 1),
        (value: 50, weight: 1),
        (value: 60, weight: 1),
        (value: 70, weight: 1),
        (value: 80, weight: 1),
        (value: 90, weight: 1),
      ],
    ),
    reroll: (standard_price: 50, enhanced_price: 0, max_per_visit: 1),
  ),

  site_rewards: (
    essence: (standard: (min: 200, max: 300), enhanced: (min: 400, max: 600)),
    reward_fallback_essence: (min: 150, max: 350),
    dreamsign_revelation: (standard_offer_count: 3, enhanced_offer_count: 4),
  ),

  purge: (
    // Each entry prices the next paid purge; the list length is the visit cap.
    marginal_costs: [40, 60, 90, 130, 180, 240],
    enhanced_discount_percent: 30,
  ),

  battle_reward: (base_essence: 100, essence_per_completion_level: 50, minimum_essence: 0),

  exploration: (default_essence_per_spark: 40),
)
